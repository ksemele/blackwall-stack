[Unit]
Description=blackwall-voice Telegram Alerter
Documentation=https://github.com/akrugliak/blackwall
After=network-online.target wazuh-manager.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 {{ alerter_install_dir }}/alerter.py
Restart=on-failure
RestartSec=10s
StandardOutput=append:{{ alerter_log_file }}
StandardError=append:{{ alerter_log_file }}

[Install]
WantedBy=multi-user.target
