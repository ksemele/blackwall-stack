#!/usr/bin/env python3
"""
blackwall-voice — Telegram Alerter
Tails /var/ossec/logs/alerts/alerts.json and forwards high-severity
alerts to a Telegram chat.

Config baked in at deploy time by Ansible.
"""

import json
import logging
import os
import time
import urllib.request
import urllib.error

# --- Config (set by Ansible) ---
ALERT_LOG      = "{{ alerter_alert_log }}"
STATE_FILE     = "{{ alerter_state_file }}"
LOG_FILE       = "{{ alerter_log_file }}"
SEVERITY_THRESHOLD = {{ severity_threshold }}
# Upper bound: alerts above it are left to Brain (None = no upper bound)
MAX_LEVEL      = {% if voice_max_level | string | trim %}{{ voice_max_level | int }}{% else %}None{% endif %}

# Synthetic test alerts of other modules (rule.id), never forwarded
IGNORE_RULE_IDS = set({{ alerter_ignore_rule_ids | map('string') | list | tojson }})
STATE_MAX_IDS  = {{ alerter_state_max_ids | int }}
POLL_INTERVAL  = {{ poll_interval }}
SEND_ATTEMPTS  = 3
BOT_TOKEN      = "{{ telegram_bot_token }}"
CHAT_ID        = "{{ telegram_chat_id }}"
TELEGRAM_URL   = f"https://api.telegram.org/bot{BOT_TOKEN}/sendMessage"

# --- Logging ---
# Log to stdout; systemd unit captures stdout → LOG_FILE via StandardOutput=append:
logging.basicConfig(
    stream=__import__("sys").stdout,
    level=logging.INFO,
    format="%(asctime)s %(levelname)s %(message)s",
)
log = logging.getLogger("voice-alerter")


def load_sent_ids() -> set:
    if not os.path.exists(STATE_FILE):
        return set()
    with open(STATE_FILE) as f:
        return {line.strip() for line in f if line.strip()}


def save_sent_id(alert_id: str) -> None:
    with open(STATE_FILE, "a") as f:
        f.write(alert_id + "\n")


STATE_COMPACT_INTERVAL = 3600
_last_compact = 0.0


def compact_state(sent_ids: set) -> None:
    """Keep only the newest STATE_MAX_IDS IDs: atomic rewrite (tmp + rename).

    The in-memory set is trimmed to match the file. Older IDs are useless:
    the tail seeks to EOF at start, so they can never come back.
    """
    global _last_compact
    _last_compact = time.monotonic()
    try:
        with open(STATE_FILE) as f:
            lines = [line.strip() for line in f if line.strip()]
    except FileNotFoundError:
        return
    except OSError as exc:
        log.error("Cannot read state file for compaction: %s", exc)
        return
    # Newest last; a repeated ID counts at its latest position.
    ordered = list(dict.fromkeys(reversed(lines)))[:STATE_MAX_IDS][::-1]
    if len(ordered) == len(lines):
        sent_ids.intersection_update(ordered)
        return
    tmp = STATE_FILE + ".tmp"
    try:
        with open(tmp, "w") as f:
            f.write("".join(i + "\n" for i in ordered))
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, STATE_FILE)
    except OSError as exc:
        log.error("State compaction failed: %s", exc)
        return
    sent_ids.intersection_update(ordered)
    log.info("Compacted state file: %d -> %d IDs", len(lines), len(ordered))


def maybe_compact_state(sent_ids: set) -> None:
    if time.monotonic() - _last_compact >= STATE_COMPACT_INTERVAL:
        compact_state(sent_ids)


def format_message(alert: dict) -> str:
    rule   = alert.get("rule", {})
    agent  = alert.get("agent", {})
    level  = rule.get("level", "?")
    desc   = rule.get("description", "no description")
    host   = agent.get("name", alert.get("manager", {}).get("name", "unknown"))
    ts     = alert.get("timestamp", "")[:19].replace("T", " ")
    full   = alert.get("full_log", "")[:300]
    return (
        f"*[BLACKWALL ALERT]* level {level}\n"
        f"Host: `{host}`\n"
        f"Rule: {desc}\n"
        f"Time: {ts}\n"
        f"```\n{full}\n```"
    )


def send_telegram(text: str) -> bool:
    payload = json.dumps({
        "chat_id": CHAT_ID,
        "text": text,
        "parse_mode": "Markdown",
    }).encode()
    req = urllib.request.Request(
        TELEGRAM_URL,
        data=payload,
        headers={"Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            return resp.status == 200
    except urllib.error.HTTPError as exc:
        # Telegram explains the refusal in the body (blocked bot, bad markup, ...).
        body = exc.read().decode(errors="replace")[:300]
        log.error("Telegram send failed: %s — %s", exc, body)
        return False
    except urllib.error.URLError as exc:
        log.error("Telegram send failed: %s", exc)
        return False


def tail_alerts(sent_ids: set) -> None:
    """Open alert log and follow new lines, processing each JSON alert.

    Handles log rotation / file replacement by detecting inode changes.
    """
    try:
        fh = open(ALERT_LOG)
    except OSError as exc:
        log.error("Cannot open alert log %s: %s", ALERT_LOG, exc)
        time.sleep(POLL_INTERVAL)
        return

    # Seek to end so we only process new alerts after startup
    fh.seek(0, 2)
    current_inode = os.fstat(fh.fileno()).st_ino
    log.info("Tailing %s (severity %d..%s, inode=%d)", ALERT_LOG, SEVERITY_THRESHOLD,
             MAX_LEVEL if MAX_LEVEL is not None else "inf", current_inode)

    while True:
        maybe_compact_state(sent_ids)

        # Detect file replacement (log rotation / lineinfile recreate)
        try:
            disk_inode = os.stat(ALERT_LOG).st_ino
        except OSError:
            disk_inode = current_inode  # file temporarily gone, keep reading

        if disk_inode != current_inode:
            log.info("Alert log replaced (old inode=%d, new inode=%d) — reopening",
                     current_inode, disk_inode)
            fh.close()
            return  # caller will reopen on next iteration

        line = fh.readline()
        if not line:
            time.sleep(POLL_INTERVAL)
            continue

        line = line.strip()
        if not line:
            continue

        try:
            alert = json.loads(line)
        except json.JSONDecodeError:
            log.warning("Non-JSON line skipped: %s", line[:80])
            continue

        rule = alert.get("rule", {})
        if str(rule.get("id", "")) in IGNORE_RULE_IDS:
            continue
        level = rule.get("level", 0)
        if level < SEVERITY_THRESHOLD:
            continue
        if MAX_LEVEL is not None and level > MAX_LEVEL:
            log.info("Skipped alert %s (level %d above voice_max_level %d, Brain covers it)",
                     alert.get("id") or alert.get("_id", ""), level, MAX_LEVEL)
            continue

        alert_id = alert.get("id") or alert.get("_id", "")
        if not alert_id:
            # Generate a rough dedup key from timestamp + rule id
            alert_id = f"{alert.get('timestamp','')}-{alert.get('rule',{}).get('id','')}"

        if alert_id in sent_ids:
            continue

        msg = format_message(alert)
        # The tail has already moved past this line, so retry here or never.
        for attempt in range(1, SEND_ATTEMPTS + 1):
            if send_telegram(msg):
                sent_ids.add(alert_id)
                save_sent_id(alert_id)
                log.info("Sent alert %s (level %d)", alert_id, level)
                break
            if attempt < SEND_ATTEMPTS:
                log.warning("Failed to send alert %s (attempt %d/%d) — retrying in %ds",
                            alert_id, attempt, SEND_ATTEMPTS, POLL_INTERVAL)
                time.sleep(POLL_INTERVAL)
        else:
            log.error("Dropped alert %s after %d failed attempts", alert_id, SEND_ATTEMPTS)


def main() -> None:
    log.info("voice-alerter starting (threshold=%d, poll=%ds)", SEVERITY_THRESHOLD, POLL_INTERVAL)
    sent_ids = load_sent_ids()
    compact_state(sent_ids)
    log.info("Loaded %d already-sent IDs from state file", len(sent_ids))

    while True:
        try:
            tail_alerts(sent_ids)
        except Exception as exc:  # noqa: BLE001
            log.exception("Unexpected error in tail loop: %s — sleeping %ds", exc, POLL_INTERVAL)
            time.sleep(POLL_INTERVAL)


if __name__ == "__main__":
    main()
