# /etc/default/blackwall-cf-refresh

# Your IPs with direct origin access bypassing Cloudflare (space-separated).
# Put here the address you deploy from and the monitoring IPs (blackwall-eye),
# otherwise they too get dropped on 80/443 once the whitelist is on.
# Leave empty if no direct access is needed at all.
ADMIN_ALLOW=""

# External interface. Empty = detect from the default route.
# Check: ip -o -4 route show to default | awk '{print $5}'
WAN_IF=""

# --- nginx real_ip ---
# Name/ID of the podman container running nginx. Empty = leave real_ip alone.
# Find it: podman ps --format '{{.Names}}\t{{.Ports}}'
NGINX_CONTAINER=""

# Path ON THE HOST to a file inside the directory mounted into the container
# as /etc/nginx/conf.d. List the mounts:
#   podman inspect $NGINX_CONTAINER --format '{{range .Mounts}}{{.Source}} -> {{.Destination}}{{"\n"}}{{end}}'
#REALIP_OUT=/opt/fehu/nginx/conf.d/cf-realip.conf

# Path for the nftables rules (normally no need to change)
#RULES_OUT=/etc/nftables.d/blackwall-wall.nft
