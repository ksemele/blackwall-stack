#!/usr/bin/env bash
#
# blackwall-cf-refresh — обновляет списки префиксов Cloudflare в двух местах:
#   1) nftables set'ы inet blackwall_wall {cf_v4,cf_v6}  (кого пускать на 80/443)
#   2) nginx set_real_ip_from                            (чей IP считать клиентским)
#
# Оба списка обязаны быть синхронны: если CF добавит префикс, а мы не обновим —
# часть легитимного трафика начнёт получать drop, и это будет выглядеть как
# случайные таймауты у части посетителей.
#
# Запуск: sudo blackwall-cf-refresh [--dry-run]
# По таймеру: blackwall-cf-refresh.timer (еженедельно)

set -euo pipefail

# shellcheck source=/dev/null
[ -r /etc/default/blackwall-cf-refresh ] && . /etc/default/blackwall-cf-refresh

TABLE="${TABLE:-blackwall_wall}"
RULES_OUT="${RULES_OUT:-/etc/nftables.d/blackwall-wall.nft}"

# nginx в контейнере podman. REALIP_OUT — путь НА ХОСТЕ к каталогу, который
# смонтирован в контейнер как /etc/nginx/conf.d. Уточнить монтирование:
#   podman inspect <container> --format '{{range .Mounts}}{{.Source}} -> {{.Destination}}{{"\n"}}{{end}}'
NGINX_CONTAINER="${NGINX_CONTAINER:-}"
REALIP_OUT="${REALIP_OUT:-/etc/nginx/conf.d/cf-realip.conf}"
NGINX_TEST_CMD="${NGINX_TEST_CMD:-podman exec $NGINX_CONTAINER nginx -t}"
NGINX_RELOAD_CMD="${NGINX_RELOAD_CMD:-podman exec $NGINX_CONTAINER nginx -s reload}"
V4_URL="${V4_URL:-https://www.cloudflare.com/ips-v4}"
V6_URL="${V6_URL:-https://www.cloudflare.com/ips-v6}"

# Внешний интерфейс. По умолчанию — тот, через который идёт default route.
# `|| true`: под `set -e` неудачная подстановка в присваивании убивает скрипт
# молча (нет ip/iproute2, нет default route) — не тот способ узнать о проблеме.
detect_wan() { ip -o -4 route show to default 2>/dev/null | awk '{print $5; exit}' || true; }
WAN_IF="${WAN_IF:-$(detect_wan)}"
WAN_IF="${WAN_IF:-eth0}"

# Дополнительные IP/подсети с прямым доступом к origin (через пробел).
# Пример: ADMIN_ALLOW="203.0.113.7 198.51.100.0/24"
ADMIN_ALLOW="${ADMIN_ALLOW:-}"

# Порог здравого смысла: если CF вернул подозрительно мало префиксов
# (обрезанный ответ, перехваченный DNS, страница-заглушка) — не трогаем
# ничего. Пустой allowlist = сайт лежит, это худший исход чем устаревший.
MIN_V4="${MIN_V4:-10}"
MIN_V6="${MIN_V6:-5}"

DRY_RUN=0
[ "${1:-}" = "--dry-run" ] && DRY_RUN=1

log() { printf '[blackwall-cf-refresh] %s\n' "$*" >&2; }
die() { log "ОШИБКА: $*"; exit 1; }

[ "$(id -u)" -eq 0 ] || die "нужен root"
command -v nft   >/dev/null || die "nft не найден"
command -v curl  >/dev/null || die "curl не найден"

tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT

# ---------- 1. забрать и проверить списки ----------

fetch() {
    curl -fsS --max-time 20 --retry 3 --retry-delay 2 --proto '=https' "$1" \
        || die "не скачался $1"
}

fetch "$V4_URL" > "$tmp/v4.raw"
fetch "$V6_URL" > "$tmp/v6.raw"

# Пропускаем только строки, которые реально выглядят как CIDR. Отсекает
# HTML-заглушки, редиректы captive portal и мусор в ответе.
grep -Ex '([0-9]{1,3}\.){3}[0-9]{1,3}/[0-9]{1,2}'  "$tmp/v4.raw" > "$tmp/v4" || true
grep -Eix '[0-9a-f:]+(:[0-9a-f]*)*/[0-9]{1,3}'     "$tmp/v6.raw" > "$tmp/v6" || true

n4="$(wc -l < "$tmp/v4" | tr -d ' ')"
n6="$(wc -l < "$tmp/v6" | tr -d ' ')"
[ "$n4" -ge "$MIN_V4" ] || die "всего $n4 IPv4-префиксов (минимум $MIN_V4) — обновление отменено"
[ "$n6" -ge "$MIN_V6" ] || die "всего $n6 IPv6-префиксов (минимум $MIN_V6) — обновление отменено"
log "получено префиксов CF: $n4 IPv4, $n6 IPv6"

# ---------- 2. собрать ruleset ----------

# Элементы set'а: отступ + запятая между строками, без висящей запятой в конце
# (nft на неё ругается "unexpected newline, expecting comma or '}'").
elements() {
    awk 'NR>1 { printf ",\n" } { printf "            %s", $0 } END { printf "\n" }' "$1"
}

admin_elements=""
if [ -n "$ADMIN_ALLOW" ]; then
    admin_elements=$(printf '%s\n' $ADMIN_ALLOW | awk 'NF' \
        | awk 'NR>1 { printf ",\n" } { printf "            %s", $0 } END { printf "\n" }')
fi

{
    cat <<'HEADER'
#!/usr/sbin/nft -f
#
# СГЕНЕРИРОВАНО blackwall-cf-refresh — правки руками будут затёрты.
# Источник шаблона: blackwall/hosts/fehu.dev/nftables/blackwall-wall.nft
HEADER
    printf '# Обновлено: %s\n\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"

    printf 'define WALL_WAN_IF = "%s"\n\n' "$WAN_IF"

    printf 'table inet %s\n' "$TABLE"
    printf 'delete table inet %s\n\n' "$TABLE"
    printf 'table inet %s {\n\n' "$TABLE"

    printf '    set cf_v4 {\n        type ipv4_addr\n        flags interval\n        auto-merge\n        elements = {\n'
    elements "$tmp/v4"
    printf '        }\n    }\n\n'

    printf '    set cf_v6 {\n        type ipv6_addr\n        flags interval\n        auto-merge\n        elements = {\n'
    elements "$tmp/v6"
    printf '        }\n    }\n\n'

    printf '    set admin_v4 {\n        type ipv4_addr\n        flags interval\n        auto-merge\n'
    if [ -n "$admin_elements" ]; then
        printf '        elements = {\n%s\n        }\n' "$admin_elements"
    fi
    printf '    }\n\n'

    # ВАЖНО: hook prerouting priority -150, а не input.
    # nginx крутится в контейнере podman, netavark DNAT-ит 443 в prerouting
    # (priority -100), после чего пакет уходит в forward мимо input.
    # Подробности и раскладка приоритетов — в nftables/blackwall-wall.nft.
    cat <<'CHAIN'
    chain prerouting {
        type filter hook prerouting priority -150; policy accept;

        # Только внешний интерфейс: иначе дропнем исходящий HTTPS контейнеров.
        iifname != $WALL_WAN_IF accept

        ct state established,related accept

        tcp dport { 80, 443 } ip  saddr @cf_v4    counter accept
        tcp dport { 80, 443 } ip6 saddr @cf_v6    counter accept
        tcp dport { 80, 443 } ip  saddr @admin_v4 counter accept

        tcp dport { 80, 443 } limit rate 10/minute \
            log prefix "[blackwall-wall] origin-direct " level info

        tcp dport { 80, 443 } counter drop
    }
}
CHAIN
} > "$tmp/blackwall-wall.nft"

# Синтаксическая проверка до применения.
nft -c -f "$tmp/blackwall-wall.nft" || die "сгенерированный ruleset не проходит nft -c"

# ---------- 3. nginx real_ip ----------

{
    printf '# СГЕНЕРИРОВАНО blackwall-cf-refresh — правки руками будут затёрты.\n'
    printf '# Обновлено: %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    printf '#\n# Без этого во всех логах и rate-limit'"'"'ах nginx клиентом будет\n'
    printf '# Cloudflare, а не реальный посетитель.\n\n'
    sed 's/^/set_real_ip_from /; s/$/;/' "$tmp/v4"
    sed 's/^/set_real_ip_from /; s/$/;/' "$tmp/v6"
    printf '\nreal_ip_header CF-Connecting-IP;\nreal_ip_recursive on;\n'
} > "$tmp/cf-realip.conf"

# ---------- 4. применить ----------

if [ "$DRY_RUN" -eq 1 ]; then
    log "--dry-run: файлы собраны, ничего не применено"
    log "ruleset:  $tmp/blackwall-wall.nft"
    log "realip:   $tmp/cf-realip.conf"
    trap - EXIT
    printf 'Артефакты в %s\n' "$tmp"
    exit 0
fi

install -d -m 0755 "$(dirname "$RULES_OUT")"
install -m 0644 "$tmp/blackwall-wall.nft" "$RULES_OUT"
nft -f "$RULES_OUT" || die "не применился ruleset (файл записан в $RULES_OUT)"
log "nftables: таблица inet $TABLE обновлена и сохранена в $RULES_OUT"

# nginx на этом хосте живёт в контейнере podman, поэтому проверка конфига и
# reload идут не через хостовые nginx/systemctl. REALIP_OUT должен указывать
# на каталог, примонтированный в контейнер как /etc/nginx/conf.d.
# Отключить блок целиком: NGINX_CONTAINER="" в /etc/default/blackwall-cf-refresh.
if [ -n "$NGINX_CONTAINER" ] && [ -d "$(dirname "$REALIP_OUT")" ]; then
    backup=""
    if [ -f "$REALIP_OUT" ]; then
        backup="$tmp/cf-realip.conf.bak"
        cp "$REALIP_OUT" "$backup"
    fi
    install -m 0644 "$tmp/cf-realip.conf" "$REALIP_OUT"

    if $NGINX_TEST_CMD >/dev/null 2>&1; then
        if $NGINX_RELOAD_CMD >/dev/null 2>&1; then
            log "nginx($NGINX_CONTAINER): $REALIP_OUT обновлён, конфиг перечитан"
        else
            log "ПРЕДУПРЕЖДЕНИЕ: конфиг валиден, но reload не прошёл — перезапусти контейнер вручную"
        fi
    else
        # Откатываем только свой файл; nginx продолжает работать со старым.
        if [ -n "$backup" ]; then cp "$backup" "$REALIP_OUT"; else rm -f "$REALIP_OUT"; fi
        die "проверка конфига nginx не прошла, $REALIP_OUT откачен"
    fi
else
    log "NGINX_CONTAINER не задан — обновление real_ip пропущено"
fi

log "готово"
