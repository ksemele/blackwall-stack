#!/usr/sbin/nft -f
#
# blackwall-base — the host's main firewall, replacing firewalld.
#
# Reproduces the behaviour of the former firewalld `public` zone, but as an
# explicit rule list. The mapping is explained in README, "Migrating from firewalld".
#
# Open to the outside:
#   22    SSH    — from anywhere (key-only login)
#   9999  zuzia  — ONLY from the monitoring service's own addresses (@zuzia_v4)
#   443   NOT here: arrives via podman DNAT and is handled in forward,
#         filtered by the separate blackwall_wall table (CF prefixes only)
#
# This table does not touch netavark's tables (`ip nat`, `ip filter`): it
# complements them rather than replacing them. Published container ports keep
# working via `ct status dnat accept` in forward — exactly as firewalld did.
#
# Apply:     sudo nft -f /etc/nftables.d/blackwall-base.nft
# Check:     sudo nft list table inet blackwall_base
# Roll back: sudo nft delete table inet blackwall_base

define BASE_WAN_IF = "eth0"

# podman subnet and bridge.
#   podman network inspect podman -f '{{range .Subnets}}{{.Subnet}}{{end}}'
#   podman network inspect podman -f '{{.NetworkInterface}}'
define PODMAN_NET = 10.88.0.0/16
define PODMAN_IF = "podman0"

table inet blackwall_base
delete table inet blackwall_base

table inet blackwall_base {

    # Open to the whole internet. Key-only login
    # (PasswordAuthentication no in /etc/ssh/sshd_config).
    #
    # 9090 (cockpit) removed 2026-08-15: `ss -lntp` showed nothing listening on
    # it — cockpit.socket is not running, the port times out from outside. The rule
    # was left over from firewalld and kept a port open to nowhere. If you ever
    # bring cockpit up — it is a root control panel for the host, don't open it to
    # the whole internet: add it the same way as @zuzia_v4 below.
    set public_tcp {
        type inet_service
        elements = { 22 }
    }

    # Addresses the zuzia service scrapes metrics on 9999 from.
    # From the service's documentation, recorded 2026-08-15.
    #
    # This list has NO auto-update (unlike the Cloudflare prefixes,
    # which blackwall-cf-refresh pulls). If zuzia changes its addresses, metrics
    # silently stop arriving — re-check whenever they change things on their side.
    set zuzia_v4 {
        type ipv4_addr
        flags interval
        auto-merge
        elements = {
            45.142.160.163,
            45.142.160.164,
            45.142.160.165,
            198.199.87.8,
            139.59.105.154
        }
    }

    chain input {
        type filter hook input priority filter; policy drop;

        iif lo accept
        ct state established,related accept
        ct state invalid drop

        # Anti-spoofing: container subnet addresses cannot arrive from the internet.
        # Must come before the rules below that trust $PODMAN_NET.
        iifname $BASE_WAN_IF ip saddr $PODMAN_NET counter drop

        # DNS from containers to aardvark-dns on the host.
        # netavark allows this in its own table:
        #     chain NETAVARK_INPUT { ip saddr 10.88.0.0/16 udp dport 53 accept }
        # but its accept doesn't help: our policy drop in another table kills the
        # packet regardless. Without these two lines containers can't resolve
        # names — silently, it looks like "network is up but nothing works".
        iifname $PODMAN_IF ip saddr $PODMAN_NET udp dport 53 counter accept
        iifname $PODMAN_IF ip saddr $PODMAN_NET tcp dport 53 counter accept

        # All of ICMP: without icmpv6, IPv6 breaks (neighbor discovery, PMTU),
        # without icmp, IPv4 path MTU discovery breaks. firewalld allowed them the same way.
        meta l4proto { icmp, ipv6-icmp } accept

        # DHCPv6 client — was in firewalld (filter_IN_public_allow).
        ip6 daddr fe80::/64 udp dport 546 accept

        tcp dport @public_tcp ct state new counter accept

        # zuzia monitoring — only from the service's addresses.
        tcp dport 9999 ip saddr @zuzia_v4 ct state new counter accept

        # Useful for blackwall-eye: shows what knocks where.
        limit rate 5/minute log prefix "[blackwall-base] input-drop " level info
        counter
    }

    chain forward {
        type filter hook forward priority filter; policy drop;

        ct state established,related accept
        ct state invalid drop

        # CRITICAL for podman: published container ports (443 -> 10.88.0.31)
        # go to forward after DNAT. firewalld had exactly this rule
        # (`ct status dnat accept` in filter_FORWARD) — without it the site goes down.
        # Filtering "who may reach 443" lives in blackwall_wall (prerouting),
        # i.e. it fires BEFORE this accept.
        ct status dnat counter accept

        # Containers going out. Same as filter_FWD_public_allow { oifname "eth0" accept }.
        oifname $BASE_WAN_IF ip saddr $PODMAN_NET counter accept

        # firewalld did not pass container-to-container traffic either — that
        # behaviour is kept. Uncomment if containers need to talk to each other:
        # iifname "podman0" oifname "podman0" accept

        limit rate 5/minute log prefix "[blackwall-base] fwd-drop " level info
        counter
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}
