#!/usr/sbin/nft -f
#
# blackwall-wall — origin cloaking for fehu.dev (93.115.20.111)
#
# Lets only Cloudflare prefixes reach TCP/80 and TCP/443, drops the rest.
# Whoever learned the direct IP from CT logs / historical DNS / favicon hash hits
# the firewall instead of the origin nginx.
#
#
# WHY hook prerouting AND NOT input
# ---------------------------------
# On this host nginx runs in a podman container (10.88.0.31), and netavark
# installs DNAT in prerouting:
#
#     chain NETAVARK-HOSTPORT-DNAT { tcp dport 443 ... }
#     chain NETAVARK-DN-...        { tcp dport 443 ... dnat to 10.88.0.31:443 }
#
# After DNAT the destination is the container, so the packet goes to forward,
# not input. Rules on hook input will NOT match it: they look applied, but the
# counter stays at zero and the origin stays open.
#
# priority -150 (mangle) is chosen deliberately:
#     -200  conntrack        <- before it, ct state is not yet known
#     -150  US
#     -100  dstnat           <- netavark DNAT
#      -90  firewalld nat_PREROUTING
# So we see the original dst port and src address before any translation.
#
#
# WHY THIS CAN'T BE DONE WITH FIREWALLD
# ---------------------------------------
# firewalld's filter_FORWARD has `ct status dnat accept` — all DNAT traffic
# slips past the zones. That's why filter_IN_public_allow has no 80/443,
# yet 443 is open from outside. A rich rule in the public zone won't close that hole.
#
#
# WHAT THIS FILE DOES NOT TOUCH
# ------------------------
#   - policy accept, matches ONLY tcp dport 80/443 on the external interface.
#   - SSH/22, cockpit/9090, 9999 — not affected at all.
#   - table inet firewalld, table ip nat and table ip filter (netavark) stay
#     untouched; both are marked "managed by ... do not touch".
#   => You cannot lock yourself out of SSH with this file — by design.
#
# Apply:     sudo nft -f /etc/nftables.d/blackwall-wall.nft
# Check:     sudo nft list table inet blackwall_wall
# Roll back: sudo nft delete table inet blackwall_wall

# External interface. Check: ip -o -4 route show to default | awk '{print $5}'
# If the name here is wrong, the rules simply filter nothing
# (fail-open), and the site stays up.
define WALL_WAN_IF = "eth0"

# Atomic reload idiom: create (if missing), delete, define again.
table inet blackwall_wall
delete table inet blackwall_wall

table inet blackwall_wall {

    set cf_v4 {
        type ipv4_addr
        flags interval
        auto-merge
        elements = {
            173.245.48.0/20,
            103.21.244.0/22,
            103.22.200.0/22,
            103.31.4.0/22,
            141.101.64.0/18,
            108.162.192.0/18,
            190.93.240.0/20,
            188.114.96.0/20,
            197.234.240.0/22,
            198.41.128.0/17,
            162.158.0.0/15,
            104.16.0.0/13,
            104.24.0.0/14,
            172.64.0.0/13,
            131.0.72.0/22
        }
    }

    set cf_v6 {
        type ipv6_addr
        flags interval
        auto-merge
        elements = {
            2400:cb00::/32,
            2606:4700::/32,
            2803:f800::/32,
            2405:b500::/32,
            2405:8100::/32,
            2a06:98c0::/29,
            2c0f:f248::/32
        }
    }

    # Your IPs for direct origin access bypassing CF (deploys, debugging,
    # monitoring health checks). Empty = nobody.
    # Filled from ADMIN_ALLOW in /etc/default/blackwall-cf-refresh.
    set admin_v4 {
        type ipv4_addr
        flags interval
        auto-merge
    }

    chain prerouting {
        type filter hook prerouting priority -150; policy accept;

        # Police the external interface only. Without this we'd drop the
        # containers' own outgoing HTTPS: a 10.88.0.31 -> internet:443 packet
        # also passes prerouting and, with dport 443 / non-CF src, would be dropped.
        iifname != $WALL_WAN_IF accept

        # Don't break established connections when rules are reloaded.
        ct state established,related accept

        # --- allowed sources ---
        tcp dport { 80, 443 } ip  saddr @cf_v4    counter accept
        tcp dport { 80, 443 } ip6 saddr @cf_v6    counter accept
        tcp dport { 80, 443 } ip  saddr @admin_v4 counter accept

        # --- everything else on 80/443 goes to the bin ---
        # Rate-limited log: shows direct-to-origin attempts without flooding
        # journald. A ready event source for blackwall-eye.
        tcp dport { 80, 443 } limit rate 10/minute \
            log prefix "[blackwall-wall] origin-direct " level info

        tcp dport { 80, 443 } counter drop
    }
}
