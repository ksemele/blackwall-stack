#!/usr/sbin/nft -f
#
# blackwall-wall — origin cloaking для fehu.dev (93.115.20.111)
#
# Пускает на TCP/80 и TCP/443 только префиксы Cloudflare, остальное дропает.
# Кто узнал прямой IP из CT-логов / historical DNS / favicon-hash — упирается
# в firewall вместо origin nginx.
#
#
# ПОЧЕМУ hook prerouting, А НЕ input
# ---------------------------------
# На этом хосте nginx работает в контейнере podman (10.88.0.31), и netavark
# вешает DNAT в prerouting:
#
#     chain NETAVARK-HOSTPORT-DNAT { tcp dport 443 ... }
#     chain NETAVARK-DN-...        { tcp dport 443 ... dnat to 10.88.0.31:443 }
#
# После DNAT адрес назначения — контейнер, поэтому пакет идёт в forward, а не
# в input. Правила на hook input по нему НЕ отработают: они будут выглядеть
# применёнными, но counter останется нулевым, а origin — открытым.
#
# priority -150 (mangle) выбран сознательно:
#     -200  conntrack        <- раньше него ct state ещё не определён
#     -150  МЫ
#     -100  dstnat           <- netavark DNAT
#      -90  firewalld nat_PREROUTING
# То есть мы видим исходные dst-порт и src-адрес до всякой трансляции.
#
#
# ПОЧЕМУ ЭТОГО НЕ СДЕЛАТЬ ЧЕРЕЗ FIREWALLD
# ---------------------------------------
# В filter_FORWARD у firewalld стоит `ct status dnat accept` — весь DNAT-трафик
# проскакивает мимо зон. Поэтому в filter_IN_public_allow портов 80/443 нет,
# а 443 снаружи при этом открыт. Rich-rule в зоне public эту дыру не закроет.
#
#
# ЧТО ЭТОТ ФАЙЛ НЕ ТРОГАЕТ
# ------------------------
#   - policy accept, матчим ТОЛЬКО tcp dport 80/443 на внешнем интерфейсе.
#   - SSH/22, cockpit/9090, 9999 — не затрагиваются вообще.
#   - table inet firewalld, table ip nat и table ip filter (netavark) остаются
#     нетронутыми; обе помечены "managed by ... do not touch".
#   => Залочить себя по SSH этим файлом невозможно — это сделано намеренно.
#
# Применить:  sudo nft -f /etc/nftables.d/blackwall-wall.nft
# Проверить:  sudo nft list table inet blackwall_wall
# Откатить:   sudo nft delete table inet blackwall_wall

# Внешний интерфейс. Проверить: ip -o -4 route show to default | awk '{print $5}'
# Если здесь окажется неверное имя — правила просто ничего не будут фильтровать
# (fail-open), сайт при этом не ляжет.
define WALL_WAN_IF = "eth0"

# Идиома атомарной перезагрузки: создать (если нет), удалить, определить заново.
table inet blackwall_wall
delete table inet blackwall_wall

table inet blackwall_wall {

    set cf_v4 {
        type ipv4_addr
        flags interval
        auto-merge
        elements = {
            173.245.48.0/20,
            103.21.244.0/22,
            103.22.200.0/22,
            103.31.4.0/22,
            141.101.64.0/18,
            108.162.192.0/18,
            190.93.240.0/20,
            188.114.96.0/20,
            197.234.240.0/22,
            198.41.128.0/17,
            162.158.0.0/15,
            104.16.0.0/13,
            104.24.0.0/14,
            172.64.0.0/13,
            131.0.72.0/22
        }
    }

    set cf_v6 {
        type ipv6_addr
        flags interval
        auto-merge
        elements = {
            2400:cb00::/32,
            2606:4700::/32,
            2803:f800::/32,
            2405:b500::/32,
            2405:8100::/32,
            2a06:98c0::/29,
            2c0f:f248::/32
        }
    }

    # Твои IP для прямого доступа к origin в обход CF (деплой, отладка,
    # health-check мониторинга). Пусто = никто.
    # Заполняется через ADMIN_ALLOW в /etc/default/blackwall-cf-refresh.
    set admin_v4 {
        type ipv4_addr
        flags interval
        auto-merge
    }

    chain prerouting {
        type filter hook prerouting priority -150; policy accept;

        # Полицейщина только на внешнем интерфейсе. Без этого мы бы дропали
        # исходящий HTTPS самих контейнеров: пакет 10.88.0.31 -> internet:443
        # тоже проходит prerouting, и по dport 443 / src не-CF попал бы под drop.
        iifname != $WALL_WAN_IF accept

        # Уже установленные соединения не рвём при перезагрузке правил.
        ct state established,related accept

        # --- разрешённые источники ---
        tcp dport { 80, 443 } ip  saddr @cf_v4    counter accept
        tcp dport { 80, 443 } ip6 saddr @cf_v6    counter accept
        tcp dport { 80, 443 } ip  saddr @admin_v4 counter accept

        # --- всё остальное на 80/443 — в мусор ---
        # Лог с rate-limit: видно попытки прямого доступа к origin, но journald
        # не заливает. Готовый источник событий для blackwall-eye.
        tcp dport { 80, 443 } limit rate 10/minute \
            log prefix "[blackwall-wall] origin-direct " level info

        tcp dport { 80, 443 } counter drop
    }
}
