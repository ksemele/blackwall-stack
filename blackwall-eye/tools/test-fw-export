#!/usr/bin/env bash
# Unit test for blackwall-fw-export: fixture JSON, no nft needed.
# Usage: tools/test-fw-export
set -u
here=$(cd "$(dirname "$0")" && pwd)
exp="$here/../ansible/roles/nftables/files/blackwall-fw-export"
fx="$here/testdata/fw-export"
fail=0

run() { # <fixture dir> <state dir>
    BLACKWALL_FW_NFT_JSON_DIR="$fx/$1" BLACKWALL_FW_STATE_DIR="$2" \
    BLACKWALL_FW_SCAN_THRESHOLD=20 BLACKWALL_FW_CONF=/nonexistent \
        python3 "$exp"
}
check() { # <name> <expected> <actual>
    if [ "$2" = "$3" ]; then echo "ok   $1"; else
        echo "FAIL $1"; echo "--- expected"; echo "$2"; echo "--- got"; echo "$3"; fail=1; fi
}

st=$(mktemp -d); trap 'rm -rf "$st"' EXIT
P="blackwall-fw: kind=input_drop"
check run1 "$P src=203.0.113.1 new=5 total=5 burst=no
$P src=203.0.113.2 new=1 total=1 burst=no" "$(run run1 "$st")"
check run1-again "" "$(run run1 "$st")"
check run2 "$P src=203.0.113.1 new=7 total=12 burst=no
$P src=203.0.113.3 new=30 total=30 burst=yes" "$(run run2 "$st")"
check run3-reload "$P src=203.0.113.1 new=2 total=2 burst=no" "$(run run3 "$st")"
check missing-set "" "$(run missing "$st")"
run missing "$st"; check missing-exit 0 "$?"
# state survives a missing set: same counters again print nothing
check after-missing "" "$(run run3 "$st")"

# Real nft JSON, both versions (fresh state)
for v in 1.0.2 1.0.9; do
    out=$(run real-nft-$v "$(mktemp -d)")
    case "$out" in *"kind=input_drop src="*"new="*"burst="*) echo "ok   real-nft-$v input_drop";;
        *) echo "FAIL real-nft-$v: $out"; fail=1;; esac
done
out=$(run real-nft-1.0.9 "$(mktemp -d)")
case "$out" in *"kind=origin_direct src="*) echo "ok   real-nft-1.0.9 origin_direct";;
    *) echo "FAIL origin_direct: $out"; fail=1;; esac

# Threshold from config file; env wins over it
conf=$(mktemp); echo "scan_threshold=3" > "$conf"
out=$(BLACKWALL_FW_NFT_JSON_DIR="$fx/run1" BLACKWALL_FW_STATE_DIR="$(mktemp -d)" BLACKWALL_FW_CONF="$conf" python3 "$exp")
check conf-threshold "$P src=203.0.113.1 new=5 total=5 burst=yes
$P src=203.0.113.2 new=1 total=1 burst=no" "$out"
rm -f "$conf"
exit $fail
