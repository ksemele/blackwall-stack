#!/usr/bin/env python3
"""
bw-status — Blackwall Eye: Wazuh agent status dashboard.

Queries the Wazuh Manager REST API and prints all agents with their
status, last heartbeat, and OS information.

Usage:
    bw-status [--host HOST] [--port PORT] [--user USER] [--password PASSWORD] [--no-color]

Defaults:
    --host      localhost
    --port      55000
    --user      wazuh
    --password  wazuh

SSH tunnel (for Docker test environment):

    Direct (if Wazuh API port is accessible from your machine):
        bw-status --host 172.28.0.10

    Via SSH tunnel:
        ssh -F tests/docker/ssh_config -L 55000:172.28.0.10:55000 black-master-00 -N &
        bw-status --host localhost

    The SSH tunnel maps local port 55000 → manager container port 55000.
    black-master-00 in tests/docker/ssh_config is reachable at localhost:2200.
"""

import argparse
import base64
import json
import ssl
import sys
import urllib.error
import urllib.request
from datetime import datetime, timezone


# --- ANSI color codes ---

RESET   = "\033[0m"
BOLD    = "\033[1m"
DIM     = "\033[2m"
GREEN   = "\033[32m"
YELLOW  = "\033[33m"
RED     = "\033[31m"
CYAN    = "\033[36m"

STATUS_COLORS = {
    "active":          GREEN,
    "disconnected":    RED,
    "never_connected": DIM,
    "pending":         YELLOW,
}


def colorize(text: str, code: str, use_color: bool) -> str:
    if not use_color or not code:
        return text
    return f"{code}{text}{RESET}"


def make_ssl_context() -> ssl.SSLContext:
    """Create an SSL context that skips certificate verification (Wazuh self-signed)."""
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    return ctx


def api_get(url: str, token: str, ctx: ssl.SSLContext) -> dict:
    req = urllib.request.Request(url, headers={"Authorization": f"Bearer {token}"})
    with urllib.request.urlopen(req, context=ctx) as resp:
        return json.loads(resp.read().decode())


def authenticate(base_url: str, user: str, password: str, ctx: ssl.SSLContext) -> str:
    """Authenticate against Wazuh API and return JWT token."""
    url = f"{base_url}/security/user/authenticate"
    credentials = base64.b64encode(f"{user}:{password}".encode()).decode()
    req = urllib.request.Request(
        url,
        method="POST",
        headers={"Authorization": f"Basic {credentials}"},
    )
    with urllib.request.urlopen(req, context=ctx) as resp:
        data = json.loads(resp.read().decode())
    return data["data"]["token"]


def fetch_agents(base_url: str, token: str, ctx: ssl.SSLContext) -> list:
    """Fetch all agents from Wazuh API (paged, limit 500)."""
    data = api_get(f"{base_url}/agents?limit=500", token, ctx)
    return data.get("data", {}).get("affected_items", [])


def parse_last_seen(raw: str | None) -> str:
    """Format ISO8601 lastKeepAlive timestamp to 'YYYY-MM-DD HH:MM' local string."""
    if not raw or raw in ("N/A",):
        return "—"
    try:
        # Python 3.11+ handles Z suffix; earlier versions need replace
        ts = raw.replace("Z", "+00:00")
        dt_utc = datetime.fromisoformat(ts)
        # Guard against sentinel timestamps: zero-time (0001-01-01, overflows astimezone)
        # and far-future sentinel (9999-12-31, used by Wazuh for the manager agent)
        if dt_utc.year < 1970 or dt_utc.year > 9000:
            return "—"
        dt_local = dt_utc.astimezone()
        return dt_local.strftime("%Y-%m-%d %H:%M")
    except (ValueError, OverflowError, OSError):
        return raw[:16] if len(raw) >= 16 else raw


def get_os_string(agent: dict) -> str:
    os_info = agent.get("os") or {}
    name = os_info.get("name", "")
    version = os_info.get("version", "")
    if name and version:
        return f"{name} {version}"
    return name or "—"


def count_by_status(agents: list) -> dict:
    counts: dict = {}
    for agent in agents:
        s = agent.get("status", "unknown")
        counts[s] = counts.get(s, 0) + 1
    return counts


def print_table(agents: list, manager_host: str, manager_port: int, use_color: bool) -> None:
    now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    headers = ("ID", "NAME", "IP", "STATUS", "LAST SEEN", "OS")
    rows = []
    for agent in sorted(agents, key=lambda a: a.get("id", "999")):
        rows.append((
            agent.get("id", "?"),
            agent.get("name", "?"),
            agent.get("ip", "?") or "?",
            agent.get("status", "unknown"),
            parse_last_seen(agent.get("lastKeepAlive")),
            get_os_string(agent),
        ))

    widths = [
        max([len(headers[i])] + [len(row[i]) for row in rows])
        for i in range(len(headers))
    ]
    sep = "─" * (sum(widths) + len(widths) - 1)

    header_label = colorize("BLACKWALL — агент статус", BOLD + CYAN, use_color)
    print(header_label)
    print(f"Manager: {manager_host}:{manager_port}   ({now})")
    print(sep)
    print(" ".join(headers[i].ljust(widths[i]) for i in range(len(headers))))
    print(sep)

    for agent_id, name, ip, status, last_seen, os_str in rows:
        status_col = colorize(status.ljust(widths[3]), STATUS_COLORS.get(status, ""), use_color)
        print(" ".join([
            agent_id.ljust(widths[0]),
            name.ljust(widths[1]),
            ip.ljust(widths[2]),
            status_col,
            last_seen.ljust(widths[4]),
            os_str.ljust(widths[5]),
        ]))

    print(sep)

    counts = count_by_status(agents)
    total        = len(agents)
    active       = counts.get("active", 0)
    disconnected = counts.get("disconnected", 0)
    never        = counts.get("never_connected", 0)
    pending      = counts.get("pending", 0)

    summary_parts = [
        f"Total: {total}",
        colorize(f"Active: {active}", GREEN, use_color),
        colorize(f"Disconnected: {disconnected}", RED if disconnected else "", use_color),
        colorize(f"Never connected: {never}", DIM if never else "", use_color),
    ]
    if pending:
        summary_parts.append(colorize(f"Pending: {pending}", YELLOW, use_color))

    print("   ".join(summary_parts))


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="bw-status",
        description="Blackwall Eye — Wazuh agent status dashboard",
    )
    parser.add_argument("--host",     default="localhost", help="Wazuh Manager hostname or IP (default: localhost)")
    parser.add_argument("--port",     default=55000,       type=int, help="Wazuh API port (default: 55000)")
    parser.add_argument("--user",     default="wazuh",     help="Wazuh API user (default: wazuh)")
    parser.add_argument("--password", default="wazuh",     help="Wazuh API password (default: wazuh)")
    parser.add_argument("--no-color", action="store_true", help="Disable ANSI color output")
    args = parser.parse_args()

    use_color = not args.no_color and sys.stdout.isatty()
    base_url  = f"https://{args.host}:{args.port}"
    ctx       = make_ssl_context()

    try:
        token = authenticate(base_url, args.user, args.password, ctx)
    except urllib.error.URLError as exc:
        reason = str(exc.reason) if hasattr(exc, "reason") else str(exc)
        print(
            f"[ERROR] Cannot connect to Wazuh API at {args.host}:{args.port} — "
            f"is the manager running?\n        ({reason})",
            file=sys.stderr,
        )
        return 1
    except urllib.error.HTTPError as exc:
        print(
            f"[ERROR] Authentication failed (HTTP {exc.code}) — check --user / --password",
            file=sys.stderr,
        )
        return 1

    try:
        agents = fetch_agents(base_url, token, ctx)
    except (urllib.error.URLError, urllib.error.HTTPError, KeyError, json.JSONDecodeError) as exc:
        print(f"[ERROR] Failed to fetch agents: {exc}", file=sys.stderr)
        return 1

    if not agents:
        print("[WARN] No agents returned by the API.", file=sys.stderr)
        return 0

    print_table(agents, args.host, args.port, use_color)
    return 0


if __name__ == "__main__":
    sys.exit(main())
