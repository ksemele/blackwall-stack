#!/usr/bin/env python3
"""blackwall-fw-export: print growth of per-source drop counters.

Managed by the Ansible role blackwall-eye/nftables. Do not edit by hand.

Reads the nft sets with per-element counters (dropped_input, dropped_forward,
origin_direct), compares with the previous run and prints one line per source
whose packet count grew:

  blackwall-fw: kind=<kind> src=<ip> new=<n> total=<n> burst=<yes|no>

A counter that went down (reload, cf-wall refresh, timeout re-add) counts as
new = current. Missing tables/sets print nothing; the exit code is always 0.

The first run (state missing or corrupt) only records a baseline and prints
nothing. State is saved before anything is printed; if it cannot be saved,
nothing is printed. At most max_lines lines are printed per run (highest new
first), the rest is summarised as:
  blackwall-fw: kind=summary suppressed=<n> burst=no

Environment overrides (tests):
  BLACKWALL_FW_NFT_JSON_DIR   read <table>.<set>.json from this dir, no nft
  BLACKWALL_FW_STATE_DIR      state directory (default /var/lib/blackwall-fw)
  BLACKWALL_FW_SCAN_THRESHOLD burst threshold (default: config file, then 20)
  BLACKWALL_FW_MAX_LINES      max lines per run (default: config file, then 200)
  BLACKWALL_FW_CONF           config file (default /etc/blackwall/fw-export.conf)
"""
import json
import os
import subprocess
import sys

SETS = [
    ("input_drop", "blackwall_base", "dropped_input"),
    ("forward_drop", "blackwall_base", "dropped_forward"),
    ("origin_direct", "blackwall_wall", "origin_direct"),
]
DEFAULT_THRESHOLD = 20
DEFAULT_MAX_LINES = 200


def err(msg):
    try:
        sys.stderr.write("blackwall-fw-export: %s\n" % msg)
    except Exception:
        pass


def setting(env, key, default):
    val = os.environ.get(env)
    if val is None:
        conf = os.environ.get("BLACKWALL_FW_CONF", "/etc/blackwall/fw-export.conf")
        try:
            with open(conf) as f:
                for line in f:
                    k, sep, v = line.strip().partition("=")
                    if sep and k.strip() == key:
                        val = v.strip()
        except OSError:
            pass
    try:
        return int(val)
    except (TypeError, ValueError):
        return default


def load_set(table, name):
    """Return the parsed nft JSON, or None when the set is not available."""
    jdir = os.environ.get("BLACKWALL_FW_NFT_JSON_DIR")
    try:
        if jdir:
            with open(os.path.join(jdir, "%s.%s.json" % (table, name))) as f:
                return json.load(f)
        out = subprocess.run(
            ["nft", "-j", "list", "set", "inet", table, name],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=20,
        )
        if out.returncode != 0:
            msg = out.stderr.decode(errors="replace")
            if "No such file or directory" not in msg:
                err("nft failed for %s %s: %s" % (table, name, msg.strip().replace("\n", " ")[:200]))
            return None
        return json.loads(out.stdout.decode())
    except (OSError, ValueError, subprocess.SubprocessError) as e:
        if not jdir or not isinstance(e, OSError):
            err("cannot read %s %s: %s" % (table, name, e))
        return None


def to_int(v):
    if isinstance(v, bool) or not isinstance(v, int):
        return None
    return v


def counters(doc):
    """{ip: packets} for elements that carry a counter (nft 1.0.2 and 1.0.9)."""
    res = {}
    if not isinstance(doc, dict):
        return res
    for item in doc.get("nftables", []) or []:
        s = item.get("set") if isinstance(item, dict) else None
        if not isinstance(s, dict):
            continue
        for e in s.get("elem", []) or []:
            e = e.get("elem", e) if isinstance(e, dict) else None
            if not isinstance(e, dict) or not isinstance(e.get("val"), str):
                continue
            c = e.get("counter")
            n = to_int(c.get("packets")) if isinstance(c, dict) else None
            if n is not None:
                res[e["val"]] = n
    return res


def ipkey(a):
    return tuple(int(p) if p.isdigit() else 0 for p in a.split("."))


def load_state(state_file):
    """Return (state, have_baseline)."""
    try:
        with open(state_file) as f:
            state = json.load(f)
    except (OSError, ValueError):
        return {}, False
    if not isinstance(state, dict):
        return {}, False
    return state, True


def run():
    state_dir = os.environ.get("BLACKWALL_FW_STATE_DIR", "/var/lib/blackwall-fw")
    state_file = os.path.join(state_dir, "state.json")
    state, have_baseline = load_state(state_file)
    thr = setting("BLACKWALL_FW_SCAN_THRESHOLD", "scan_threshold", DEFAULT_THRESHOLD)
    max_lines = setting("BLACKWALL_FW_MAX_LINES", "max_lines", DEFAULT_MAX_LINES)

    events = []  # (new, kind, ip, total)
    for kind, table, name in SETS:
        doc = load_set(table, name)
        if doc is None:
            continue  # keep the old state: the set may come back
        cur = counters(doc)
        prev = state.get(kind)
        prev = prev if isinstance(prev, dict) else {}
        for ip, total in cur.items():
            old = to_int(prev.get(ip))
            if old is None:
                old = 0
            new = total - old if total >= old else total
            if new > 0:
                events.append((new, kind, ip, total))
        state[kind] = cur

    try:
        os.makedirs(state_dir, mode=0o700, exist_ok=True)
        tmp = state_file + ".tmp"
        with open(tmp, "w") as f:
            json.dump(state, f)
        os.replace(tmp, state_file)
    except OSError as e:
        err("cannot save state, printing nothing: %s" % e)
        return
    if not have_baseline:
        err("baseline recorded")
        return

    events.sort(key=lambda t: (-t[0], t[1], ipkey(t[2])))
    lines = ["blackwall-fw: kind=%s src=%s new=%d total=%d burst=%s"
             % (k, ip, n, t, "yes" if n >= thr else "no") for n, k, ip, t in events[:max(max_lines, 0)]]
    if len(events) > len(lines):
        lines.append("blackwall-fw: kind=summary suppressed=%d burst=no" % (len(events) - len(lines)))
    if lines:
        print("\n".join(lines))


def main():
    try:
        run()
    except Exception as e:  # the agent must never see a crash
        err("unexpected error: %r" % (e,))
    return 0


if __name__ == "__main__":
    sys.exit(main())
