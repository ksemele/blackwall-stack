[Unit]
Description=Blackwall: weekly Cloudflare prefix refresh

[Timer]
OnCalendar=weekly
# Jitter, so we don't hit cloudflare.com/ips exactly at midnight along with everyone else.
RandomizedDelaySec=6h
# If the host was off when the timer was due, catch up after boot.
Persistent=true

[Install]
WantedBy=timers.target
