#!/usr/bin/env bash
#
# blackwall-cf-refresh — refreshes the Cloudflare prefix lists in two places:
#   1) nftables sets inet blackwall_wall {cf_v4,cf_v6}  (who may reach 80/443)
#   2) nginx set_real_ip_from                         (whose IP counts as the client)
#
# Both lists must stay in sync: if CF adds a prefix and we don't update —
# part of the legitimate traffic starts getting dropped, and it looks like
# random timeouts for some visitors.
#
# Run: sudo blackwall-cf-refresh [--dry-run]
# On a timer: blackwall-cf-refresh.timer (weekly)

set -euo pipefail

# shellcheck source=/dev/null
[ -r /etc/default/blackwall-cf-refresh ] && . /etc/default/blackwall-cf-refresh

TABLE="${TABLE:-blackwall_wall}"
RULES_OUT="${RULES_OUT:-/etc/nftables.d/blackwall-wall.nft}"

# nginx runs in a podman container. REALIP_OUT is the path ON THE HOST to the
# directory mounted into the container as /etc/nginx/conf.d. Check the mount:
#   podman inspect <container> --format '{{range .Mounts}}{{.Source}} -> {{.Destination}}{{"\n"}}{{end}}'
NGINX_CONTAINER="${NGINX_CONTAINER:-}"
REALIP_OUT="${REALIP_OUT:-/etc/nginx/conf.d/cf-realip.conf}"
NGINX_TEST_CMD="${NGINX_TEST_CMD:-podman exec $NGINX_CONTAINER nginx -t}"
NGINX_RELOAD_CMD="${NGINX_RELOAD_CMD:-podman exec $NGINX_CONTAINER nginx -s reload}"
V4_URL="${V4_URL:-https://www.cloudflare.com/ips-v4}"
V6_URL="${V6_URL:-https://www.cloudflare.com/ips-v6}"

# TCP ports the filter covers (space-separated).
PORTS="${PORTS:-80 443}"

# External interface. Defaults to the one carrying the default route.
# `|| true`: under `set -e` a failed substitution in an assignment kills the
# script silently (no ip/iproute2, no default route) — not how we want to find out.
detect_wan() { ip -o -4 route show to default 2>/dev/null | awk '{print $5; exit}' || true; }
WAN_IF="${WAN_IF:-$(detect_wan)}"
WAN_IF="${WAN_IF:-eth0}"

# Extra IPs/subnets with direct origin access (space-separated).
# Example: ADMIN_ALLOW="203.0.113.7 198.51.100.0/24"
ADMIN_ALLOW="${ADMIN_ALLOW:-}"

# Sanity threshold: if CF returned suspiciously few prefixes
# (truncated response, hijacked DNS, captive page) — touch
# nothing. An empty allowlist = site down, which is worse than a stale one.
MIN_V4="${MIN_V4:-10}"
MIN_V6="${MIN_V6:-5}"

DRY_RUN=0
[ "${1:-}" = "--dry-run" ] && DRY_RUN=1

log() { printf '[blackwall-cf-refresh] %s\n' "$*" >&2; }
die() { log "ERROR: $*"; exit 1; }

[ "$(id -u)" -eq 0 ] || die "must run as root"
command -v nft   >/dev/null || die "nft not found"
command -v curl  >/dev/null || die "curl not found"

tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT

# ---------- 1. fetch and validate the lists ----------

fetch() {
    curl -fsS --max-time 20 --retry 3 --retry-delay 2 --proto '=https' "$1" \
        || die "failed to download $1"
}

fetch "$V4_URL" > "$tmp/v4.raw"
fetch "$V6_URL" > "$tmp/v6.raw"

# Keep only lines that really look like CIDRs. Filters out
# HTML placeholders, captive-portal redirects and junk in the response.
grep -Ex '([0-9]{1,3}\.){3}[0-9]{1,3}/[0-9]{1,2}'  "$tmp/v4.raw" > "$tmp/v4" || true
grep -Eix '[0-9a-f:]+(:[0-9a-f]*)*/[0-9]{1,3}'     "$tmp/v6.raw" > "$tmp/v6" || true

n4="$(wc -l < "$tmp/v4" | tr -d ' ')"
n6="$(wc -l < "$tmp/v6" | tr -d ' ')"
[ "$n4" -ge "$MIN_V4" ] || die "only $n4 IPv4 prefixes (minimum $MIN_V4) — update aborted"
[ "$n6" -ge "$MIN_V6" ] || die "only $n6 IPv6 prefixes (minimum $MIN_V6) — update aborted"
log "CF prefixes received: $n4 IPv4, $n6 IPv6"

# ---------- 2. build the ruleset ----------

# Set elements: indent + comma between lines, no trailing comma at the end
# (nft rejects it with "unexpected newline, expecting comma or '}'").
elements() {
    awk 'NR>1 { printf ",\n" } { printf "            %s", $0 } END { printf "\n" }' "$1"
}

admin_elements=""
if [ -n "$ADMIN_ALLOW" ]; then
    admin_elements=$(printf '%s\n' $ADMIN_ALLOW | awk 'NF' \
        | awk 'NR>1 { printf ",\n" } { printf "            %s", $0 } END { printf "\n" }')
fi

ports_nft="$(printf '%s\n' $PORTS | awk 'NF' | paste -sd, - | sed 's/,/, /g')"
[ -n "$ports_nft" ] || die "PORTS is empty"

{
    cat <<'HEADER'
#!/usr/sbin/nft -f
#
# GENERATED by blackwall-cf-refresh — manual edits will be overwritten.
# Source: blackwall-eye/ansible/roles/cf-wall (Ansible-managed)
HEADER
    printf '# Updated: %s\n\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"

    printf 'define WALL_WAN_IF = "%s"\n\n' "$WAN_IF"

    printf 'table inet %s\n' "$TABLE"
    printf 'delete table inet %s\n\n' "$TABLE"
    printf 'table inet %s {\n\n' "$TABLE"

    printf '    set cf_v4 {\n        type ipv4_addr\n        flags interval\n        auto-merge\n        elements = {\n'
    elements "$tmp/v4"
    printf '        }\n    }\n\n'

    printf '    set cf_v6 {\n        type ipv6_addr\n        flags interval\n        auto-merge\n        elements = {\n'
    elements "$tmp/v6"
    printf '        }\n    }\n\n'

    printf '    set admin_v4 {\n        type ipv4_addr\n        flags interval\n        auto-merge\n'
    if [ -n "$admin_elements" ]; then
        printf '        elements = {\n%s\n        }\n' "$admin_elements"
    fi
    printf '    }\n\n'

    # IMPORTANT: hook prerouting priority -150, not input.
    # nginx runs in a podman container, netavark DNATs 443 in prerouting
    # (priority -100), after which the packet goes to forward, bypassing input.
    # Details: the cf-wall role README.
    sed "s/@PORTS@/$ports_nft/g" <<'CHAIN'
    chain prerouting {
        type filter hook prerouting priority -150; policy accept;

        # External interface only: otherwise we'd drop the containers' outgoing HTTPS.
        iifname != $WALL_WAN_IF accept

        ct state established,related accept

        tcp dport { @PORTS@ } ip  saddr @cf_v4    counter accept
        tcp dport { @PORTS@ } ip6 saddr @cf_v6    counter accept
        tcp dport { @PORTS@ } ip  saddr @admin_v4 counter accept

        tcp dport { @PORTS@ } limit rate 10/minute \
            log prefix "[blackwall-wall] origin-direct " level info

        tcp dport { @PORTS@ } counter drop
    }
}
CHAIN
} > "$tmp/blackwall-wall.nft"

# Syntax check before applying.
nft -c -f "$tmp/blackwall-wall.nft" || die "generated ruleset fails nft -c"

# ---------- 3. nginx real_ip ----------

{
    printf '# GENERATED by blackwall-cf-refresh — manual edits will be overwritten.\n'
    printf '# Updated: %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    printf '#\n# Without this, every nginx log and rate limit would see\n'
    printf '# Cloudflare as the client instead of the real visitor.\n\n'
    sed 's/^/set_real_ip_from /; s/$/;/' "$tmp/v4"
    sed 's/^/set_real_ip_from /; s/$/;/' "$tmp/v6"
    printf '\nreal_ip_header CF-Connecting-IP;\nreal_ip_recursive on;\n'
} > "$tmp/cf-realip.conf"

# ---------- 4. apply ----------

if [ "$DRY_RUN" -eq 1 ]; then
    log "--dry-run: files built, nothing applied"
    log "ruleset:  $tmp/blackwall-wall.nft"
    log "realip:   $tmp/cf-realip.conf"
    trap - EXIT
    printf 'Artifacts in %s\n' "$tmp"
    exit 0
fi

install -d -m 0755 "$(dirname "$RULES_OUT")"
install -m 0644 "$tmp/blackwall-wall.nft" "$RULES_OUT"
nft -f "$RULES_OUT" || die "ruleset failed to apply (file written to $RULES_OUT)"
log "nftables: table inet $TABLE updated and saved to $RULES_OUT"

# nginx on this host lives in a podman container, so the config check and
# reload don't go through the host's nginx/systemctl. REALIP_OUT must point
# at the directory mounted into the container as /etc/nginx/conf.d.
# Disable the whole block: NGINX_CONTAINER="" in /etc/default/blackwall-cf-refresh.
if [ -n "$NGINX_CONTAINER" ] && [ -d "$(dirname "$REALIP_OUT")" ]; then
    backup=""
    if [ -f "$REALIP_OUT" ]; then
        backup="$tmp/cf-realip.conf.bak"
        cp "$REALIP_OUT" "$backup"
    fi
    install -m 0644 "$tmp/cf-realip.conf" "$REALIP_OUT"

    if $NGINX_TEST_CMD >/dev/null 2>&1; then
        if $NGINX_RELOAD_CMD >/dev/null 2>&1; then
            log "nginx($NGINX_CONTAINER): $REALIP_OUT updated, config reloaded"
        else
            log "WARNING: config is valid but reload failed — restart the container manually"
        fi
    else
        # Roll back only our own file; nginx keeps running with the old one.
        if [ -n "$backup" ]; then cp "$backup" "$REALIP_OUT"; else rm -f "$REALIP_OUT"; fi
        die "nginx config check failed, $REALIP_OUT rolled back"
    fi
else
    log "NGINX_CONTAINER not set — real_ip update skipped"
fi

log "done"
