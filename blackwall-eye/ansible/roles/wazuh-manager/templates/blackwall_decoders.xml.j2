<!-- Managed by blackwall-eye (ansible role wazuh-manager). Do not edit on the host. -->

<!-- Firewall drop events: one line per source printed by
     /usr/local/sbin/blackwall-fw-export (agent command localfile, alias
     blackwall-fw). Full event:
       ossec: output: 'blackwall-fw': blackwall-fw: kind=...
     Both decoders anchor on that whole prefix (children of the stock `ossec`
     decoder), so stray lines never match. The summary line has its own
     decoder (no src); exporter stderr lines (blackwall-fw-export: ...) have a
     third one. Type ossec keeps stock rules 500/530 matching. Rule 100200
     matches the prefix plus the decoded fw_kind field. -->

<!-- kind=<input_drop|forward_drop|origin_direct|any drop-in kind, e.g. blocklist_would_drop|blocklist_dropped> src=<ip> new=<n> total=<n> burst=<yes|no> -->
<decoder name="blackwall-fw">
  <parent>ossec</parent>
  <type>ossec</type>
  <prematch offset="after_parent">^output: 'blackwall-fw': blackwall-fw: kind=\w+ src=</prematch>
  <regex type="pcre2" offset="after_parent">^output: 'blackwall-fw': blackwall-fw: kind=(\w+) src=(\S+) new=(\d+) total=(\d+) burst=(yes|no)$</regex>
  <order>fw_kind, srcip, fw_new, fw_total, fw_burst</order>
</decoder>

<!-- kind=summary suppressed=<n> burst=no (no src) -->
<decoder name="blackwall-fw-summary">
  <parent>ossec</parent>
  <type>ossec</type>
  <prematch offset="after_parent">^output: 'blackwall-fw': blackwall-fw: kind=summary </prematch>
  <regex type="pcre2" offset="after_parent">^output: 'blackwall-fw': blackwall-fw: kind=(summary) suppressed=(\d+) burst=(no)$</regex>
  <order>fw_kind, fw_suppressed, fw_burst</order>
</decoder>

<!-- exporter stderr: blackwall-fw-export: <message> -->
<decoder name="blackwall-fw-error">
  <parent>ossec</parent>
  <type>ossec</type>
  <prematch offset="after_parent">^output: 'blackwall-fw': blackwall-fw-export: </prematch>
  <regex type="pcre2" offset="after_parent">^output: 'blackwall-fw': blackwall-fw-export: (.*)$</regex>
  <order>fw_error</order>
</decoder>
