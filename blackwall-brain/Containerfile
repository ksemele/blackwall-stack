# Blackwall Brain v2. Built on the target by the brain-analyst role:
#   podman build -t localhost/blackwall-brain:<version> .
FROM docker.io/library/python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY requirements.lock .
RUN pip install --require-hashes -r requirements.lock

COPY pyproject.toml .
COPY src/ src/
RUN pip install --no-deps . \
 && useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin brain \
 && install -d -o brain -g brain /var/lib/brain-analyst

USER brain
ENTRYPOINT ["brain"]
