BRAIN_ANALYSIS_THRESHOLD={{ analysis_threshold }}
# {{ ansible_managed }}
BRAIN_IGNORE_RULE_IDS={{ brain_ignore_rule_ids | map('string') | join(',') }}
BRAIN_POLL_INTERVAL={{ poll_interval }}
BRAIN_MAX_BACKFILL={{ brain_max_backfill }}
BRAIN_STATE_FILE=/var/lib/brain-analyst/state.json
BRAIN_STATE_MAX_IDS={{ brain_state_max_ids }}
BRAIN_INDEXER_URL={{ brain_indexer_url }}
BRAIN_INDEXER_USER={{ brain_indexer_user }}
BRAIN_INDEXER_PASSWORD={{ brain_indexer_password }}
BRAIN_INDEXER_VERIFY_TLS={{ brain_indexer_verify_tls | bool | lower }}
BRAIN_INDEXER_CA_FILE={{ '/etc/brain-analyst/indexer-ca.pem' if brain_indexer_ca_file else '' }}
BRAIN_MODEL_BACKEND={{ brain_model_backend }}
BRAIN_MODEL={{ brain_model }}
BRAIN_MODEL_API_KEY={{ brain_model_api_key }}
BRAIN_MODEL_BASE_URL={{ brain_model_base_url }}
BRAIN_MODEL_TIMEOUT={{ brain_model_timeout }}
BRAIN_MODEL_MAX_TOKENS={{ brain_model_max_tokens }}
BRAIN_MODEL_OPTIONS={{ brain_model_options | dict2items | rejectattr('value', 'equalto', '') | items2dict | to_json }}
BRAIN_TELEGRAM_BOT_TOKEN={{ telegram_bot_token }}
BRAIN_TELEGRAM_CHAT_ID={{ telegram_chat_id }}
BRAIN_DASHBOARD_URL={{ brain_dashboard_url }}
BRAIN_RULE_LINKS={{ brain_rule_links | to_json }}
