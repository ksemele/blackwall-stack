[Unit]
Description=Blackwall Brain — AI alert analyst
Documentation=https://github.com/akrugliak/blackwall
After=network-online.target wazuh-manager.service
Wants=network-online.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -u {{ brain_install_dir }}/brain.py
User=root
Restart=on-failure
RestartSec=10s
StandardOutput=append:{{ brain_log_file }}
StandardError=append:{{ brain_log_file }}

[Install]
WantedBy=multi-user.target
