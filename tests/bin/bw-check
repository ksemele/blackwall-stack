#!/usr/bin/env bash
#
# bw-check — verify the Blackwall test environment.
#
# Usage:   tests/bin/bw-check all        # every check
#          tests/bin/bw-check metrics    # one group
#
# Exit code is 0 only when nothing FAILed, so this is usable from CI.
# `set -e` is deliberately omitted: the point of `bw-check all` is to run every
# check and show the whole picture, not to stop at the first breakage.
#
# Full documentation: tests/README.md
set -uo pipefail

# shellcheck source=_bw-common.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_bw-common.sh"

BW_PASS=0
BW_FAIL=0
BW_SKIP=0

# black-dead-98 is stopped on purpose by tests/triggers/broken-agents.yml,
# so host-level checks exclude it.
# The sentinel group is provisioned by its own playbook and checked by its own
# target; the main-stack checks skip it.
BW_LIVE_HOSTS='!black-dead-98:!sentinel'

bw_pass() { BW_PASS=$((BW_PASS + 1)); printf '  %sPASS%s %s\n' "$BW_GREEN"  "$BW_RESET" "$*"; }
bw_fail() { BW_FAIL=$((BW_FAIL + 1)); printf '  %sFAIL%s %s\n' "$BW_RED"    "$BW_RESET" "$*"; }
bw_skip() { BW_SKIP=$((BW_SKIP + 1)); printf '  %sSKIP%s %s\n' "$BW_YELLOW" "$BW_RESET" "$*"; }

# bw_run <description> <command...> — PASS on exit 0, FAIL otherwise.
# Command output is shown only on failure, last 25 lines.
bw_run() {
  local desc="$1"
  shift
  local out
  if out="$("$@" 2>&1)"; then
    bw_pass "$desc"
  else
    bw_fail "$desc"
    printf '%s\n' "$out" | tail -25 | sed 's/^/      /'
  fi
}

# bw_json_true <python expression over `d`> — reads JSON on stdin,
# exits 0 when the expression is truthy. Avoids a hard dependency on jq.
bw_json_true() {
  python3 -c '
import json, sys
d = json.load(sys.stdin)
sys.exit(0 if eval(sys.argv[1]) else 1)
' "$1" 2>/dev/null
}

# bw_tcp_probe <host> <port> — portable replacement for `nc -z`:
# macOS and Linux disagree on nc timeout flags, python3 exists on both.
bw_tcp_probe() {
  python3 -c '
import socket, sys
s = socket.socket()
s.settimeout(3)
try:
    s.connect((sys.argv[1], int(sys.argv[2])))
except OSError:
    sys.exit(1)
finally:
    s.close()
' "$1" "$2"
}

# Surface the per-host debug lines the verify playbooks print.
bw_show_reports() {
  grep -oE '"msg": "black-[^"]+"' | sed 's/"msg": "/      /; s/"$//' || true
}

usage() {
  cat <<USAGE
bw-check — verify the Blackwall test environment

Usage: bw-check [check]

Checks:
  all        run everything (default)
  hosts      containers are running, ansible can reach them
  versions   expected packages are installed, with versions
  nft        applied nftables ruleset and open ports
  cf-wall    Cloudflare origin filter (cf-wall role)
  ports      listeners inside containers + published ports from the host
  wazuh      agent registration, REST API, broken-agent fixtures, dashboard
  metrics    node_exporter, Prometheus targets, Grafana health and datasource
  voice      telegram-alerter
  brain      brain-analyst (Claude analysis delivered to Telegram)
  sentinel   Wazuh server stack on black-sentinel-03 (opt-in: SKIP when not deployed)
  sentinel-agents  throwaway agent enrolls in the sentinel (opt-in, internet, ~2-3 min; not in 'all')
  fw-events  firewall drops become Wazuh alerts 100201/100202 (opt-in, ~1 min, up to ~3 min on failure; not in 'all')
  fang       reputation blocklists on the sentinel: observe, enforce, junk list, restore (opt-in, ~3-5 min, re-provisions fang; not in 'all')
  vm         auditd role on a real RHEL kernel (Lima VM, bw-lab vm up): reload, restart, broken rule, immutable + reboot (opt-in, ~5-8 min; not in 'all')

Exit code: 0 when nothing failed, 1 otherwise.
USAGE
}

check_hosts() {
  bw_info "hosts"
  bw_require_docker

  local running
  running="$(docker ps --format '{{.Names}}')"
  local name
  for name in black-master-00 black-host-01 black-metrics-00 black-grafana-00 black-aptcache-00; do
    if grep -qx "$name" <<<"$running"; then
      bw_pass "container $name is running"
    else
      bw_fail "container $name is not running"
    fi
  done

  bw_require_ansible
  bw_run "ansible reaches the systemd nodes" \
    bw_ansible_adhoc blackwall-eye all --limit "$BW_LIVE_HOSTS" -m ping
}

check_versions() {
  bw_info "package versions"
  bw_require_ansible

  # Versions are worth seeing on success too, not only on failure.
  local out rc
  out="$(bw_ansible blackwall-eye ansible/playbooks/verify-versions.yml \
           --limit "$BW_LIVE_HOSTS" 2>&1)"
  rc=$?
  printf '%s\n' "$out" | bw_show_reports
  if (( rc == 0 )); then
    bw_pass "expected packages are installed, agent version matches manager"
  else
    bw_fail "packages missing or agent/manager version mismatch"
    printf '%s\n' "$out" | tail -25 | sed 's/^/      /'
  fi
}

check_nft() {
  bw_info "nftables"
  bw_require_ansible

  local out
  if out="$(bw_ansible blackwall-eye ansible/playbooks/verify-nftables.yml \
              --limit "$BW_LIVE_HOSTS" 2>&1)"; then
    # Every host ending early means nft is missing — the kernel of the container
    # runtime has no nf_tables. That is a SKIP, not a FAIL.
    if grep -q 'ok=1 ' <<<"$out" && ! grep -q 'blackwall_base' <<<"$out"; then
      bw_skip "nftables unavailable in the containers — kernel without nf_tables"
    else
      printf '%s\n' "$out" | bw_show_reports
      bw_pass "ruleset applied, expected ports are open"
    fi
  else
    bw_fail "ruleset does not match expectations"
    printf '%s\n' "$out" | tail -25 | sed 's/^/      /'
  fi
}

# _probe_state <ansible stat output> — present | absent | error. Only an explicit
# "exists" verdict counts; UNREACHABLE/FAILED/empty output is an error, never a SKIP.
_probe_state() {
  if grep -q '"exists": true' <<<"$1"; then echo present
  elif grep -q '"exists": false' <<<"$1"; then echo absent
  else echo error; fi
}

check_cf_wall() {
  bw_info "cf-wall"
  bw_require_ansible

  # Opt-in: `bw-lab provision all` leaves it out (it fetches from cloudflare.com).
  local installed
  installed="$(bw_ansible_adhoc blackwall-eye cf_wall -b \
                 -m stat -a 'path=/usr/local/sbin/blackwall-cf-refresh' 2>&1)"
  case "$(_probe_state "$installed")" in
    present) ;;
    error)
      bw_fail "cf-wall prerequisite probe failed (host unreachable?)"
      printf '%s\n' "$installed" | tail -5 | sed 's/^/      /'
      return ;;
    *) bw_skip "cf-wall is not deployed (run: bw-lab provision cf-wall)"
       return ;;
  esac

  bw_run "Cloudflare filter loaded, refresh is safe" \
    bw_ansible blackwall-eye ansible/playbooks/verify-cf-wall.yml --limit "$BW_LIVE_HOSTS"
}

check_ports() {
  bw_info "open ports"
  bw_require_ansible

  bw_run "expected listeners inside the containers" \
    bw_ansible blackwall-eye ansible/playbooks/verify-ports.yml --limit "$BW_LIVE_HOSTS"

  # Published ports are probed from the Mac itself: docker NAT sits between the
  # host and the container, and a break in it is invisible from the inside.
  local entry port label
  for entry in "2200:ssh black-master-00" "2201:ssh black-host-01" \
               "5601:wazuh-dashboard" "55000:wazuh-api" "9200:wazuh-indexer" "9090:prometheus" "3000:grafana"; do
    port="${entry%%:*}"
    label="${entry#*:}"
    if bw_tcp_probe localhost "$port"; then
      bw_pass "published port $port ($label) reachable from the host"
    else
      bw_fail "published port $port ($label) unreachable from the host"
    fi
  done
}

check_wazuh() {
  bw_info "wazuh"
  bw_require_ansible

  bw_run "agents are registered on the manager" \
    bw_ansible blackwall-eye ansible/playbooks/verify-agents.yml
  bw_run "agent events reach the indexer" \
    bw_ansible blackwall-eye ansible/playbooks/verify-agent-events.yml
  bw_run "manager REST API answers" \
    bw_ansible blackwall-eye ansible/playbooks/verify-api.yml

  local icode
  icode="$(curl -sk -m 5 -o /dev/null -w '%{http_code}' -u "$BW_INDEXER_AUTH" "$BW_INDEXER_URL/" 2>/dev/null)"
  if [[ "$icode" == "200" ]]; then
    bw_pass "indexer answers at $BW_INDEXER_URL"
  else
    bw_fail "indexer does not answer at $BW_INDEXER_URL (code '$icode')"
  fi

  local token rules
  token="$(curl -sk -m 5 -u "$BW_API_AUTH" -X POST \
             'https://127.0.0.1:55000/security/user/authenticate?raw=true' 2>/dev/null)"
  rules="$(curl -sk -m 5 -H "Authorization: Bearer $token" \
             'https://127.0.0.1:55000/rules?rule_ids=100100' 2>/dev/null)"
  if bw_json_true "d['data']['total_affected_items'] == 1" <<<"$rules"; then
    bw_pass "rule 100100 (blackwall sessions) is loaded"
  else
    bw_fail "rule 100100 is not loaded on the manager"
  fi

  check_fixtures

  local code
  code="$(curl -sk -m 5 -o /dev/null -w '%{http_code}' "$BW_DASHBOARD_URL/" 2>/dev/null)"
  if [[ "$code" =~ ^(2|3)[0-9][0-9]$ ]]; then
    bw_pass "dashboard answers ($code) at $BW_DASHBOARD_URL"
  else
    bw_fail "dashboard does not answer at $BW_DASHBOARD_URL (code '$code')"
  fi
}

# Broken-agent fixtures from `bw-lab provision fixtures`. The manager needs up
# to wazuh_agents_disconnection_time (1m in the lab) to notice the stopped
# container, so dead-98 gets a short grace period instead of failing at once.
check_fixtures() {
  local agents i
  for i in $(seq 1 10); do
    agents="$(bw_ansible_adhoc blackwall-eye wazuh_managers -b \
                -m command -a '/var/ossec/bin/agent_control -l' 2>&1)"
    grep -q 'black-dead-98, IP: [^,]*, Disconnected' <<<"$agents" && break
    sleep 9
  done

  if grep -q 'black-ghost-99, IP: [^,]*, Never connected' <<<"$agents"; then
    bw_pass "fixture black-ghost-99 is never_connected"
  else
    bw_fail "fixture black-ghost-99 missing (run: bw-lab provision fixtures)"
  fi
  if grep -q 'black-dead-98, IP: [^,]*, Disconnected' <<<"$agents"; then
    bw_pass "fixture black-dead-98 is disconnected"
  else
    bw_fail "fixture black-dead-98 is not disconnected (run: bw-lab provision fixtures)"
    grep 'black-dead-98' <<<"$agents" | sed 's/^/      /'
  fi
}

check_metrics() {
  bw_info "metrics"
  bw_require_ansible

  bw_run "node_exporter serves metrics on every host" \
    bw_ansible blackwall-voice ansible/playbooks/verify-metrics.yml --limit "$BW_LIVE_HOSTS"

  local targets
  if ! targets="$(curl -sf -m 5 "$BW_PROM_URL/api/v1/targets?state=active" 2>/dev/null)"; then
    bw_fail "prometheus does not answer at $BW_PROM_URL"
    return
  fi

  local host
  for host in black-master-00 black-host-01; do
    if bw_json_true "any(t['labels']['instance'] == '$host:9100' and t['health'] == 'up'
                         for t in d['data']['activeTargets'])" <<<"$targets"; then
      bw_pass "prometheus scrapes $host"
    else
      bw_fail "target $host:9100 is not up"
    fi
  done

  if curl -sf -m 5 --get --data-urlencode 'query=node_load1' \
       "$BW_PROM_URL/api/v1/query" 2>/dev/null \
       | bw_json_true "len(d['data']['result']) > 0"; then
    bw_pass "query node_load1 returns data"
  else
    bw_fail "query node_load1 is empty — metrics are not reaching prometheus"
  fi

  if curl -sf -m 5 -u "$BW_GRAFANA_AUTH" "$BW_GRAFANA_URL/api/health" 2>/dev/null \
       | bw_json_true "d['database'] == 'ok'"; then
    bw_pass "grafana is healthy"
  else
    bw_fail "grafana does not answer at $BW_GRAFANA_URL"
  fi

  if curl -sf -m 5 -u "$BW_GRAFANA_AUTH" "$BW_GRAFANA_URL/api/datasources" 2>/dev/null \
       | bw_json_true "sum(1 for x in d if x['name'] == 'Prometheus') == 1"; then
    bw_pass "Prometheus datasource is provisioned"
  else
    bw_fail "Prometheus datasource is missing in grafana"
  fi

  if curl -sf -m 5 -u "$BW_GRAFANA_AUTH" \
       "$BW_GRAFANA_URL/api/dashboards/uid/blackwall-hosts" 2>/dev/null \
       | bw_json_true "d['dashboard']['title'] == 'Blackwall hosts'"; then
    bw_pass "dashboard 'Blackwall hosts' is loaded"
  else
    bw_fail "dashboard blackwall-hosts is not loaded in grafana"
  fi
}

check_voice() {
  bw_info "voice"
  bw_require_ansible

  # voice is opt-in: `bw-lab provision all` leaves it out because the alerter
  # needs a real Telegram token. Not deployed is a SKIP, deployed but dead is a FAIL.
  # Probed with `stat`, not `systemctl`: a failing systemctl call makes ansible
  # echo the command back, and the unit name in that error text would match a
  # naive grep.
  local installed
  installed="$(bw_ansible_adhoc blackwall-voice wazuh_managers -b \
                 -m stat -a 'path=/etc/systemd/system/voice-alerter.service' 2>&1)"
  case "$(_probe_state "$installed")" in
    present) ;;
    error)
      bw_fail "voice prerequisite probe failed (host unreachable?)"
      printf '%s\n' "$installed" | tail -5 | sed 's/^/      /'
      return ;;
    *) bw_skip "telegram-alerter is not deployed (run: bw-lab provision voice)"
       return ;;
  esac

  bw_run "telegram-alerter is running" \
    bw_ansible blackwall-voice ansible/playbooks/verify-voice.yml
}

check_brain() {
  bw_info "brain"
  bw_require_ansible

  # Opt-in like voice: needs a Claude API key and a Telegram token.
  local installed
  installed="$(bw_ansible_adhoc blackwall-brain wazuh_managers -b \
                 -m stat -a 'path=/etc/systemd/system/brain-analyst.service' 2>&1)"
  case "$(_probe_state "$installed")" in
    present) ;;
    error)
      bw_fail "brain prerequisite probe failed (host unreachable?)"
      printf '%s\n' "$installed" | tail -5 | sed 's/^/      /'
      return ;;
    *) bw_skip "brain-analyst is not deployed (run: bw-lab provision brain)"
       return ;;
  esac

  # brain_enabled=false keeps the files but stops and disables the service.
  # `|| true` keeps rc 0, so ansible prints the bare state on its own line.
  local enabled
  enabled="$(bw_ansible_adhoc blackwall-brain wazuh_managers -b \
               -m shell -a 'systemctl is-enabled brain-analyst || true' 2>&1)"
  if grep -qE 'UNREACHABLE|FAILED' <<<"$enabled"; then
    bw_fail "brain prerequisite probe failed (host unreachable?)"
    return
  fi
  if ! grep -qx 'enabled' <<<"$enabled"; then
    bw_skip "brain-analyst is disabled (brain_enabled=false; enable: bw-lab provision brain)"
    return
  fi

  bw_run "brain-analyst image is built" \
    bw_ansible_adhoc blackwall-brain wazuh_managers -b \
      -m shell -a 'podman image ls -q localhost/blackwall-brain | grep -q .'

  bw_run "brain-analyst analysed and delivered a test alert" \
    bw_ansible blackwall-brain ansible/playbooks/verify-brain.yml
}

bw_summary() {
  printf '\n%s%s passed%s, %s%s failed%s, %s%s skipped%s\n' \
    "$BW_GREEN" "$BW_PASS" "$BW_RESET" \
    "$BW_RED" "$BW_FAIL" "$BW_RESET" \
    "$BW_YELLOW" "$BW_SKIP" "$BW_RESET"
  (( BW_FAIL == 0 ))
}

check_sentinel() {
  bw_info "sentinel"
  bw_require_ansible

  # Opt-in: not part of `bw-lab provision all`. Not deployed is a SKIP.
  local installed
  installed="$(bw_ansible_adhoc blackwall-eye sentinel -b \
                 -m stat -a 'path=/etc/wazuh-dashboard/opensearch_dashboards.yml' 2>&1)"
  case "$(_probe_state "$installed")" in
    present) ;;
    error)
      bw_fail "sentinel node is unreachable or the probe failed"
      printf '%s\n' "$installed" | tail -5 | sed 's/^/      /'
      return ;;
    *) bw_skip "sentinel stack is not deployed (run: bw-lab provision sentinel)"
       return ;;
  esac

  bw_run "sentinel: services, closed ports, agent 000, nginx, podman tables survive reload" \
    bw_ansible blackwall-eye ansible/playbooks/verify-sentinel.yml
}

# Sentinel-side ssh (password from the lab, same as bw-lab ssh).
_sa_ssh() {
  if command -v sshpass >/dev/null 2>&1; then
    sshpass -p "$BW_SSH_PASSWORD" ssh -F "$BW_SSH_CONFIG" black-sentinel-03 "$@"
  else
    ssh -F "$BW_SSH_CONFIG" black-sentinel-03 "$@"
  fi
}

# Remove the probe container and every agent entry with the probe name.
# Idempotent. manage_agents output is kept in SA_CLEAN_ERR for the failure message.
_sa_cleanup() {
  docker rm -f "$SA_NAME" >/dev/null 2>&1
  SA_CLEAN_ERR="$(_sa_ssh "for id in \$(/var/ossec/bin/agent_control -l \
      | sed -n 's/.*ID: \([0-9]*\), Name: $SA_NAME,.*/\1/p'); do \
      /var/ossec/bin/manage_agents -r \"\$id\"; done" 2>&1)"
}

# agent_control -l output of the sentinel; non-zero when unreachable.
_sa_agents() { _sa_ssh '/var/ossec/bin/agent_control -l' 2>&1; }

# Number of indexed alerts for the probe agent name.
_sa_alert_count() {
  _sa_ssh "curl -sk -m 10 -u '$BW_INDEXER_AUTH' \
      'https://127.0.0.1:9200/wazuh-alerts-*/_count?q=agent.name:$SA_NAME'" 2>/dev/null \
    | python3 -c 'import json,sys; print(json.load(sys.stdin)["count"])' 2>/dev/null
}

# input-chain packet counters of the 1514 and 1515 rules, "events enroll".
_sa_counters() {
  _sa_ssh "nft list chain inet blackwall_base input" 2>/dev/null | awk '
    /dport 1514/ { for (i = 1; i <= NF; i++) if ($i == "packets") e = $(i + 1) }
    /dport 1515/ { for (i = 1; i <= NF; i++) if ($i == "packets") r = $(i + 1) }
    END { print e + 0, r + 0 }'
}

_sa_run() {
  local version
  version="$(sed -n 's/^wazuh_version: *"\{0,1\}\([0-9.]*\)"\{0,1\}.*/\1/p' \
               "$BW_ROOT/blackwall-eye/ansible/roles/wazuh-repo/defaults/main.yml" | head -1)"
  if [[ -z "$version" ]]; then
    bw_fail "cannot read wazuh_version from the wazuh-repo role defaults"
    return
  fi

  local before base
  before="$(_sa_counters)"
  # Earlier runs leave their alerts in the indexer: require growth over this baseline.
  base="$(_sa_alert_count)"
  base="${base:-0}"

  local runerr
  if ! runerr="$(docker run -d --name "$SA_NAME" --hostname "$SA_NAME" --privileged --cgroupns=host \
         --tmpfs /run --tmpfs /run/lock --network "$SA_NETWORK" --ip "$SA_IP" \
         "$SA_IMAGE" 2>&1)"; then
    bw_fail "probe container $SA_NAME did not start"
    printf '%s\n' "$runerr" | tail -5 | sed 's/^/      /'
    return
  fi

  local out
  if ! out="$(docker exec -e WAZUH_MANAGER="$SA_MANAGER" -e WAZUH_AGENT_NAME="$SA_NAME" \
        -e WV="$version" "$SA_NAME" bash -ec '
    printf "%s\n" "[wazuh]" "name=Wazuh repository" \
      "baseurl=https://packages.wazuh.com/4.x/yum/" \
      "gpgkey=https://packages.wazuh.com/key/GPG-KEY-WAZUH" \
      "gpgcheck=1" "enabled=1" > /etc/yum.repos.d/wazuh.repo
    dnf -y install "wazuh-agent-$WV"
    systemctl enable --now wazuh-agent' 2>&1)"; then
    bw_fail "probe agent $version install/start failed"
    printf '%s\n' "$out" | tail -25 | sed 's/^/      /'
    return
  fi
  bw_pass "probe $SA_NAME ($SA_IP) installed wazuh-agent $version"

  local i active=0 agents
  for ((i = 0; i < 40; i++)); do
    agents="$(_sa_agents)"
    if grep -qE "Name: $SA_NAME,.*Active" <<<"$agents"; then
      active=1; break
    fi
    sleep 5
  done
  if ((active)); then
    bw_pass "agent $SA_NAME enrolled and Active on the sentinel"
  else
    bw_fail "agent $SA_NAME did not become Active within 200s"
    docker exec "$SA_NAME" tail -5 /var/ossec/logs/ossec.log 2>&1 | sed 's/^/      /'
    return
  fi

  local after
  after="$(_sa_counters)"
  if [[ "$(awk -v b1="${before% *}" -v b2="${before#* }" '{print ($1 > b1 && $2 > b2)}' <<<"$after")" == 1 ]]; then
    bw_pass "input-chain counters for 1514/1515 grew ($before -> $after)"
  else
    bw_fail "input-chain counters for 1514/1515 did not grow ($before -> $after)"
  fi

  local hits=0
  for ((i = 0; i < 24; i++)); do
    hits="$(_sa_alert_count)"
    [[ "${hits:-0}" -gt "$base" ]] && break
    sleep 5
  done
  if [[ "${hits:-0}" -gt "$base" ]]; then
    bw_pass "indexer alerts for agent.name:$SA_NAME grew ($base -> $hits)"
  else
    bw_fail "no new alerts for agent.name:$SA_NAME in the sentinel indexer (baseline $base, now ${hits:-0})"
  fi

  local os=0
  for ((i = 0; i < 24; i++)); do
    os="$(_sa_ssh "t=\$(curl -sk -m 10 -u $BW_API_AUTH -X POST \
          'https://127.0.0.1:55000/security/user/authenticate?raw=true'); \
        id=\$(/var/ossec/bin/agent_control -l | sed -n 's/.*ID: \([0-9]*\), Name: $SA_NAME,.*/\1/p'); \
        curl -sk -m 10 -H \"Authorization: Bearer \$t\" \
          \"https://127.0.0.1:55000/syscollector/\$id/os\"" 2>/dev/null \
      | python3 -c 'import json,sys; print(json.load(sys.stdin)["data"]["total_affected_items"])' 2>/dev/null)"
    [[ "${os:-0}" -gt 0 ]] && break
    sleep 5
  done
  if [[ "${os:-0}" -gt 0 ]]; then
    bw_pass "API returns syscollector OS data for $SA_NAME"
  else
    bw_fail "API returned no syscollector OS data for $SA_NAME"
  fi
}

# Opt-in (needs internet, ~2-3 min): a throwaway RHEL-family container installs
# wazuh-agent from the public repo and enrolls in the sentinel over the lab
# network. Self-cleaning: the container and the agent entry go away on any exit.
check_sentinel_agents() {
  bw_info "sentinel-agents"
  bw_require_ansible
  bw_require_docker

  local installed
  installed="$(bw_ansible_adhoc blackwall-eye sentinel -b \
                 -m stat -a 'path=/etc/wazuh-dashboard/opensearch_dashboards.yml' 2>&1)"
  case "$(_probe_state "$installed")" in
    present) ;;
    error)
      bw_fail "sentinel node is unreachable or the probe failed"
      printf '%s\n' "$installed" | tail -5 | sed 's/^/      /'
      return ;;
    *) bw_skip "sentinel stack is not deployed (run: bw-lab provision sentinel)"
       return ;;
  esac

  # Probe constants. 172.28.0.10-.16, .98 and .99 belong to the inventory.
  SA_NAME="black-probe-90"
  SA_IP="172.28.0.90"
  SA_NETWORK="blackwall-test_blackwall-test"
  SA_IMAGE="blackwall-test-black-rocky-02"
  # BW_PROBE_MANAGER is a test hook: point the probe at a wrong manager IP to
  # exercise the failure and cleanup path.
  SA_MANAGER="${BW_PROBE_MANAGER:-172.28.0.16}"

  # Cleanup on any exit; signals become exits so the EXIT trap runs.
  trap _sa_cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'exit 129' HUP
  _sa_cleanup            # leftover from an interrupted earlier run
  _sa_run
  _sa_cleanup
  trap - EXIT INT TERM HUP

  local left="" agents
  docker inspect "$SA_NAME" >/dev/null 2>&1 && left="container"
  if agents="$(_sa_agents)"; then
    grep -q "Name: $SA_NAME," <<<"$agents" && left="$left agent-entry"
  else
    left="$left sentinel-unreachable"
  fi
  if [[ -z "$left" ]]; then
    bw_pass "probe container and agent entry removed"
  else
    bw_fail "probe cleanup incomplete:$left"
    printf '%s\n' "$SA_CLEAN_ERR" | tail -5 | sed 's/^/      /'
  fi
}

# --- fw-events ---------------------------------------------------------------

_fe_ssh() {
  local host="$1"; shift
  if command -v sshpass >/dev/null 2>&1; then
    sshpass -p "$BW_SSH_PASSWORD" ssh -F "$BW_SSH_CONFIG" -o ConnectTimeout=10 "$host" "$@"
  else
    ssh -F "$BW_SSH_CONFIG" -o ConnectTimeout=10 "$host" "$@"
  fi
}

# _fe_probe <host> <test-expr> — prints present|absent|error (one retry on ssh error).
_fe_probe() {
  local host="$1" expr="$2" out i
  for i in 1 2; do
    out="$(_fe_ssh "$host" "if $expr; then echo present; else echo absent; fi" 2>/dev/null | tail -1)"
    [[ "$out" == present || "$out" == absent ]] && { printf '%s' "$out"; return; }
    sleep 2
  done
  printf 'error'
}

# _fe_count <main|sentinel> <rule> <agent> <srcip> <since-iso> — alerts newer than <since>.
_fe_count() {
  local where="$1" rule="$2" agent="$3" src="$4" since="$5" body
  body='{"query":{"bool":{"filter":[{"term":{"rule.id":"'"$rule"'"}},{"term":{"agent.name":"'"$agent"'"}},{"term":{"data.srcip":"'"$src"'"}},{"range":{"@timestamp":{"gte":"'"$since"'"}}}]}}}'
  if [[ "$where" == main ]]; then
    curl -sk -m 10 -u "$BW_INDEXER_AUTH" -H 'Content-Type: application/json' \
        -d "$body" "$BW_INDEXER_URL/wazuh-alerts-*/_count"
  else
    _fe_ssh black-sentinel-03 "curl -sk -m 10 -u '$BW_INDEXER_AUTH' -H 'Content-Type: application/json' \
        -d '$body' 'https://127.0.0.1:9200/wazuh-alerts-*/_count'"
  fi 2>/dev/null \
    | python3 -c 'import json,sys; print(json.load(sys.stdin)["count"])' 2>/dev/null
}

# input_drop total recorded by the exporter on host-01 for 172.28.0.15 (0 when absent).
_fe_input_total() {
  _fe_ssh black-host-01 'cat /var/lib/blackwall-fw/state.json' 2>/dev/null \
    | python3 -c 'import json,sys; v=json.load(sys.stdin).get("input_drop",{}).get("172.28.0.15",0); print(v.get("s",0) if isinstance(v,dict) else v)' 2>/dev/null
}

# _fe_wait <main|sentinel> <rule> <agent> <srcip> <since> — poll up to 150 s, print the count.
_fe_wait() {
  local i n=0
  for ((i = 0; i < 30; i++)); do
    n="$(_fe_count "$@")"
    [[ "${n:-0}" -gt 0 ]] && break
    sleep 5
  done
  printf '%s' "${n:-0}"
}

# Opt-in (~1 min): drops on the lab firewalls must become Wazuh alerts end to end.
# rocky-02 (172.28.0.15, not in the sentinel's cfwall_admin_allow) generates the traffic.
check_fw_events() {
  bw_info "fw-events"

  local h
  for h in black-host-01 black-rocky-02 black-sentinel-03; do
    if ! _fe_ssh "$h" true >/dev/null 2>&1; then
      bw_fail "$h is unreachable"
      return
    fi
  done
  # Prerequisites: sentinel stack first (clearer hint), then the exporter on both hosts.
  local st
  st="$(_fe_probe black-sentinel-03 'test -f /etc/wazuh-dashboard/opensearch_dashboards.yml')"
  if [[ "$st" == error ]]; then
    bw_fail "ssh to black-sentinel-03 failed during prerequisite probe"
    return
  elif [[ "$st" == absent ]]; then
    bw_skip "sentinel stack is not deployed (run: bw-lab provision sentinel)"
    return
  fi
  for h in black-host-01 black-sentinel-03; do
    st="$(_fe_probe "$h" 'test -x /usr/local/sbin/blackwall-fw-export')"
    if [[ "$st" == error ]]; then
      bw_fail "ssh to $h failed during prerequisite probe"
      return
    elif [[ "$st" == absent ]]; then
      bw_skip "blackwall-fw-export is not deployed on $h (run: bw-lab provision nftables)"
      return
    fi
  done
  if [[ -z "$(_fe_count main 100202 black-host-01 172.28.0.15 2000-01-01T00:00:00Z)" ]]; then
    bw_fail "main indexer does not answer at $BW_INDEXER_URL"
    return
  fi
  if [[ -z "$(_fe_count sentinel 100201 black-sentinel-03 172.28.0.15 2000-01-01T00:00:00Z)" ]]; then
    bw_fail "sentinel indexer does not answer"
    return
  fi

  # The exporter needs a baseline run before it reports growth: wait for the
  # state file on both hosts (the agent runs it every wazuh_fw_events_interval).
  local i ok
  for h in black-host-01 black-sentinel-03; do
    ok=0
    for ((i = 0; i < 12; i++)); do
      if _fe_ssh "$h" 'test -s /var/lib/blackwall-fw/state.json' >/dev/null 2>&1; then ok=1; break; fi
      sleep 5
    done
    if ((!ok)); then
      bw_fail "$h: exporter has no state file after 60 s (is the localfile command running?)"
      return
    fi
  done
  bw_pass "exporter baseline exists on black-host-01 and black-sentinel-03"

  # Test start from the lab clock (containers share it), minus a little slack.
  local start
  start="$(_fe_ssh black-sentinel-03 'date -u -d "-3 seconds" +%Y-%m-%dT%H:%M:%SZ' 2>/dev/null)"
  if [[ -z "$start" ]]; then
    bw_fail "cannot read the lab clock"
    return
  fi

  # 1. Below threshold: 3 dropped ports must stay at level 0 (no 100202). Level-0
  # rows are not indexed, so the exporter's state file proves it saw the drops.
  local before
  before="$(_fe_input_total)"
  _fe_ssh black-rocky-02 'for p in 20101 20102 20103; do
      (timeout 0.5 bash -c "echo > /dev/tcp/172.28.0.11/$p" >/dev/null 2>&1 &) ; done; sleep 1' >/dev/null 2>&1
  sleep 30    # >= 2 exporter intervals (lab: 10 s): these drops are exported before the scan
  local below after
  after="$(_fe_input_total)"
  if [[ "${after:-0}" -gt "${before:-0}" ]]; then
    bw_pass "exporter state on black-host-01 counted the 3 drops (input_drop total $before -> $after)"
  else
    bw_fail "exporter state on black-host-01 did not grow after 3 drops ($before -> ${after:-?})"
  fi
  below="$(_fe_count main 100202 black-host-01 172.28.0.15 "$start")"
  if [[ "${below:-x}" == 0 ]]; then
    bw_pass "3 dropped ports from 172.28.0.15: no scan alert (100202)"
  else
    bw_fail "3 dropped ports produced ${below:-?} alert(s) of rule 100202"
  fi

  # 2. Scan + origin-direct, concurrently.
  _fe_ssh black-rocky-02 'for p in $(seq 20200 20259); do
      (timeout 0.5 bash -c "echo > /dev/tcp/172.28.0.11/$p" >/dev/null 2>&1 &) ; done
      for n in 1 2 3; do
        (timeout 0.5 bash -c "echo > /dev/tcp/172.28.0.16/443" >/dev/null 2>&1 &) ; done; sleep 1' >/dev/null 2>&1

  local scan origin
  scan="$(_fe_wait main 100202 black-host-01 172.28.0.15 "$start")"
  if [[ "$scan" -gt 0 ]]; then
    bw_pass "60 dropped ports -> rule 100202 for black-host-01, srcip 172.28.0.15 (main indexer)"
  else
    bw_fail "no rule 100202 alert for black-host-01 / 172.28.0.15 within 150 s"
  fi
  origin="$(_fe_wait sentinel 100201 black-sentinel-03 172.28.0.15 "$start")"
  if [[ "$origin" -gt 0 ]]; then
    bw_pass "origin-direct to 172.28.0.16:443 -> rule 100201, srcip 172.28.0.15 (sentinel indexer)"
  else
    bw_fail "no rule 100201 alert for black-sentinel-03 / 172.28.0.15 within 150 s"
  fi
}

# --- fang --------------------------------------------------------------------

# _fg_counter <table> <set> <ip> — packets counted for <ip> in an nft set on the
# sentinel; 0 when the element is absent; empty when the sentinel cannot be read.
# With a 4th argument "present" it prints 1 when the element exists, else 0.
_fg_counter() {
  _fe_ssh black-sentinel-03 "nft -j list set inet $1 $2" 2>/dev/null \
    | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except ValueError:
    sys.exit(1)
n = 0
for item in d.get("nftables", []):
    for e in (item.get("set") or {}).get("elem", []) or []:
        e = e.get("elem", e) if isinstance(e, dict) else None
        if isinstance(e, dict) and e.get("val") == sys.argv[1]:
            n = 1 if len(sys.argv) > 2 else (e.get("counter") or {}).get("packets", 0)
print(n)
' "$3" ${4:+"$4"} 2>/dev/null
}

# Sentinel connection attempts from <host> (default rocky-02, the listed lab source): 5 x :443.
_fg_poke() {
  _fe_ssh "${1:-black-rocky-02}" 'for n in 1 2 3 4 5; do
      (timeout 0.5 bash -c "echo > /dev/tcp/172.28.0.16/443" >/dev/null 2>&1 &) ; done; sleep 1' >/dev/null 2>&1
}

# blocklist_static must hold no private/reserved space (the lab exempts rocky's /32 only).
# Layer 2 helpers: quick SYNs to one port (parallel, short timeout), flagged-set membership.
_fg_syns() { # <from-host> <first-port> <count> [step]
  _fe_ssh "$1" 'p='"$2"'; for ((n = 0; n < '"$3"'; n++)); do
      (timeout 0.5 bash -c "echo > /dev/tcp/172.28.0.16/$p" >/dev/null 2>&1 &)
      p=$((p + '"${4:-0}"')); done; sleep 1' >/dev/null 2>&1
}
_fg_flagged() { # <set> <ip>: prints 1 when the source is in the flagged set
  _fg_counter blackwall_fang "$1" "$2" present
}
_fg_reserved_check() {
  _fe_ssh black-sentinel-03 'nft -j list set inet blackwall_fang blocklist_static' 2>/dev/null \
    | python3 -c '
import ipaddress as ip, json, sys
d = json.load(sys.stdin)
res = [ip.ip_network(x) for x in ("0.0.0.0/8", "10.0.0.0/8", "100.64.0.0/10", "127.0.0.0/8",
       "169.254.0.0/16", "172.16.0.0/12", "192.0.0.0/24", "192.0.2.0/24", "192.168.0.0/16",
       "198.18.0.0/15", "198.51.100.0/24", "203.0.113.0/24", "224.0.0.0/3")]
nets = []
for item in d["nftables"]:
    for e in (item.get("set") or {}).get("elem", []) or []:
        if isinstance(e, dict) and "prefix" in e:
            nets.append(ip.ip_network("%s/%s" % (e["prefix"]["addr"], e["prefix"]["len"])))
        elif isinstance(e, dict) and "range" in e:
            nets.extend(ip.summarize_address_range(ip.ip_address(e["range"][0]), ip.ip_address(e["range"][1])))
        elif isinstance(e, str):
            nets.append(ip.ip_network(e))
ok = ip.ip_network("172.28.0.15/32")   # lab exemption (fang_test_blockable)
bad = [str(n) for n in nets if n != ok and any(n.overlaps(r) for r in res)]
master = [str(n) for n in nets if ip.ip_address("172.28.0.10") in n]
print("entries=%d" % len(nets))
if bad or master:
    print("reserved/allowlisted entries present: %s" % (bad + master))
    sys.exit(1)
'
}

# Fingerprint of everything the refresh must not touch on failure (hits excluded).
_fg_fingerprint() {
  _fe_ssh black-sentinel-03 'nft list set inet blackwall_fang allow_v4; nft list set inet blackwall_fang blocklist_static;
      nft list chain inet blackwall_fang prerouting; cat /etc/nftables.d/blackwall-fang.nft' 2>/dev/null | md5sum
}

_fg_provision() { # <observe|enforce>
  bw_ansible blackwall-fang ansible/playbooks/fang.yml -e "fang_mode=$1" 2>&1
}

# Always leave Fang in observe mode, whatever happened above.
_fg_restore() {
  local out
  if out="$(_fg_provision observe)"; then
    bw_pass "restored: fang provisioned back to observe"
  else
    bw_fail "could not restore observe mode (run: bw-lab provision fang)"
    printf '%s\n' "$out" | tail -15 | sed 's/^/      /'
  fi
}

# rule-only alert count on the sentinel indexer: _fg_rule_count <rule> <since-iso>
_fg_rule_count() {
  local body='{"query":{"bool":{"filter":[{"term":{"rule.id":"'"$1"'"}},{"term":{"agent.name":"black-sentinel-03"}},{"range":{"@timestamp":{"gte":"'"$2"'"}}}]}}}'
  _fe_ssh black-sentinel-03 "curl -sk -m 10 -u '$BW_INDEXER_AUTH' -H 'Content-Type: application/json' \
      -d '$body' 'https://127.0.0.1:9200/wazuh-alerts-*/_count'" 2>/dev/null \
    | python3 -c 'import json,sys; print(json.load(sys.stdin)["count"])' 2>/dev/null
}

# Forces a fetch failure with a cached copy (dry run, nothing applied): WARNING -> exit 3.
_fg_degraded_refresh() {
  _fe_ssh black-sentinel-03 'set -u
      d=$(mktemp -d); st=$d/state; cp -r /var/lib/blackwall-fang "$st"
      python3 - "$d" "$st" <<PY
import importlib.machinery, importlib.util, sys
d, st = sys.argv[1:3]
l = importlib.machinery.SourceFileLoader("f", "/usr/local/sbin/blackwall-fang-refresh")
sp = importlib.util.spec_from_loader("f", l); m = importlib.util.module_from_spec(sp); l.exec_module(m)
m.STATE_DIR = st
src = m.read_conf("/etc/blackwall/fang.conf")["SOURCES"].split()
m.cache_save("file://%s/gone.netset" % d, m.cache_load(src[0]))
PY
      second=$(grep ^SOURCES= /etc/blackwall/fang.conf | tr " " "\n" | tail -1 | tr -d "\"")
      sed "s#^SOURCES=.*#SOURCES=\"file://$d/gone.netset $second\"#" /etc/blackwall/fang.conf > "$d/c.conf"
      systemd-run --quiet --wait --pipe -E BLACKWALL_FANG_CONF="$d/c.conf" -E BLACKWALL_FANG_STATE="$st" \
          /usr/local/sbin/blackwall-fang-refresh --dry-run >/dev/null 2>&1
      echo $?; rm -rf "$d"' 2>/dev/null | tail -1
}

# Opt-in (~4-6 min): observe (+ layer 2 attempt detectors) -> enforce -> junk list -> back to observe, on the sentinel.
# rocky-02 (172.28.0.15) is on the lab test list; master (172.28.0.10) is allowlisted;
# host-01 (172.28.0.11) is neither.
check_fang() {
  bw_info "fang"
  bw_require_ansible

  local h
  for h in black-master-00 black-host-01 black-rocky-02 black-sentinel-03; do
    if ! _fe_ssh "$h" true >/dev/null 2>&1; then
      bw_fail "$h is unreachable"
      return
    fi
  done
  local st
  st="$(_fe_probe black-sentinel-03 'nft list table inet blackwall_fang >/dev/null 2>&1')"
  if [[ "$st" == error ]]; then
    bw_fail "ssh to black-sentinel-03 failed during prerequisite probe"
    return
  elif [[ "$st" == absent ]]; then
    bw_skip "fang is not deployed on black-sentinel-03 (run: bw-lab provision fang)"
    return
  fi
  st="$(_fe_probe black-sentinel-03 'test -x /usr/local/sbin/blackwall-fw-export')"
  if [[ "$st" != present ]]; then
    bw_fail "blackwall-fw-export is not usable on black-sentinel-03 (run: bw-lab provision sentinel)"
    return
  fi
  st="$(_fe_probe black-sentinel-03 'test -f /etc/wazuh-dashboard/opensearch_dashboards.yml')"
  if [[ "$st" == absent ]]; then
    bw_skip "sentinel stack is not deployed (run: bw-lab provision sentinel)"
    return
  elif [[ "$st" == error ]]; then
    bw_fail "ssh to black-sentinel-03 failed during prerequisite probe"
    return
  fi
  st="$(_fe_probe black-sentinel-03 'grep -q "^TEST_MODE=1" /etc/blackwall/fang.conf')"
  if [[ "$st" != present ]]; then
    bw_skip "fang lab test configuration is not active (host_vars/black-sentinel-03.yml, run: bw-lab provision fang)"
    return
  fi
  if [[ -z "$(_fe_count sentinel 100206 black-sentinel-03 172.28.0.15 2000-01-01T00:00:00Z)" ]]; then
    bw_fail "sentinel indexer does not answer"
    return
  fi

  # Whatever happens (also ^C), leave Fang in observe mode.
  trap '_fg_restore; trap - INT TERM; exit 130' INT TERM

  # Known starting point: observe, test lists loaded.
  local out
  if ! out="$(_fg_provision observe)"; then
    bw_fail "provision fang (observe) failed"
    printf '%s\n' "$out" | tail -15 | sed 's/^/      /'
    trap - INT TERM
    return
  fi

  # 1. no private/reserved space in blocklist_static; master carved out.
  local res
  if res="$(_fg_reserved_check)"; then
    bw_pass "blocklist_static holds no private/reserved ranges, master is carved out ($res)"
  else
    bw_fail "blocklist_static: $res"
  fi

  # 2. observe: rocky hits are counted and alerted, not dropped.
  local start o0 o1 h0 h1 alerts
  start="$(_fe_ssh black-sentinel-03 'date -u -d "-3 seconds" +%Y-%m-%dT%H:%M:%SZ' 2>/dev/null)"
  if [[ -z "$start" ]]; then
    bw_fail "cannot read the lab clock"
    _fg_restore
    trap - INT TERM
    return
  fi
  sleep 15   # the exporter records the fresh table as a baseline first
  o0="$(_fg_counter blackwall_wall origin_direct 172.28.0.15)"
  h0="$(_fg_counter blackwall_fang fang_hits 172.28.0.15)"
  _fg_poke
  sleep 2
  h1="$(_fg_counter blackwall_fang fang_hits 172.28.0.15)"
  o1="$(_fg_counter blackwall_wall origin_direct 172.28.0.15)"
  if [[ -n "$h1" && "$h1" -gt "${h0:-0}" ]]; then
    bw_pass "observe: rocky counted in fang_hits ($h0 -> $h1 packets)"
  else
    bw_fail "observe: fang_hits for rocky did not grow ($h0 -> ${h1:-?}) after 5 connection attempts"
  fi
  if [[ "${o1:-0}" -gt "${o0:-0}" ]]; then
    bw_pass "observe: nothing dropped by fang, cf-wall still sees rocky (origin_direct $o0 -> $o1)"
  else
    bw_fail "observe: cf-wall origin_direct did not grow for rocky ($o0 -> ${o1:-?}); fang may be dropping in observe mode"
  fi
  _fg_poke    # a second burst so the exporter sees growth after its baseline
  alerts="$(_fe_wait sentinel 100206 black-sentinel-03 172.28.0.15 "$start")"
  if [[ "$alerts" -gt 0 ]]; then
    bw_pass "observe: rule 100206 (blocklist_would_drop) for srcip 172.28.0.15 (sentinel indexer)"
  else
    bw_fail "observe: no rule 100206 alert for 172.28.0.15 within 150 s"
  fi

  # 2a. layer 2 (observe): attempt detectors flag rocky, spare host-01 and master, drop nothing.
  # Flagged sets keep entries for 1h, so compare against baselines taken now.
  local lstart s0 s1 c0 c1 r0 r1 hs0 hs1 a1 a2 a3 mf banner
  lstart="$(_fe_ssh black-sentinel-03 'date -u -d "-3 seconds" +%Y-%m-%dT%H:%M:%SZ' 2>/dev/null)"
  s0="$(_fg_counter blackwall_fang ssh_flagged 172.28.0.15)"
  c0="$(_fg_counter blackwall_fang scan_flagged 172.28.0.15)"
  r0="$(_fg_counter blackwall_fang rate_flagged 172.28.0.15)"
  hs0="$(_fg_counter blackwall_fang ssh_flagged 172.28.0.11)"
  _fg_syns black-host-01 22 2
  _fg_syns black-master-00 22 20
  _fg_syns black-rocky-02 22 20
  _fg_syns black-rocky-02 20001 30 1
  sleep 15   # exporter baseline, then growth for it to report
  _fg_syns black-rocky-02 22 20
  _fg_syns black-rocky-02 20001 30 1
  sleep 2
  s1="$(_fg_counter blackwall_fang ssh_flagged 172.28.0.15)"
  c1="$(_fg_counter blackwall_fang scan_flagged 172.28.0.15)"
  r1="$(_fg_counter blackwall_fang rate_flagged 172.28.0.15)"
  hs1="$(_fg_counter blackwall_fang ssh_flagged 172.28.0.11)"
  if [[ -z "$s0" || -z "$s1" || -z "$c0" || -z "$c1" || -z "$r0" || -z "$r1" || -z "$hs0" || -z "$hs1" ]]; then
    bw_fail "layer 2: could not read counters"
    s0=0; s1=0; c0=0; c1=0; r0=0; r1=0; hs0=x; hs1=y
  fi
  mf="$(_fg_flagged ssh_flagged 172.28.0.10)"
  if [[ "${s1:-0}" -gt "${s0:-0}" ]]; then
    bw_pass "layer 2: rocky flagged by the SSH detector (ssh_flagged $s0 -> $s1)"
  else
    bw_fail "layer 2: rocky not flagged in ssh_flagged after 40 SSH attempts ($s0 -> ${s1:-?})"
  fi
  if [[ "${c1:-0}" -gt "${c0:-0}" ]]; then
    bw_pass "layer 2: rocky flagged by the scan detector (scan_flagged $c0 -> $c1)"
  else
    bw_fail "layer 2: rocky not flagged in scan_flagged after 60 closed-port connects ($c0 -> ${c1:-?})"
  fi
  if [[ "${r1:-0}" -gt "${r0:-0}" ]]; then
    bw_pass "layer 2: rocky flagged by the rate detector (rate_flagged $r0 -> $r1)"
  else
    bw_fail "layer 2: rocky not flagged in rate_flagged after ~100 new connections ($r0 -> ${r1:-?})"
  fi
  if [[ "${hs1:-0}" == "${hs0:-0}" ]]; then
    bw_pass "layer 2: host-01 with 2 SSH attempts is not newly flagged"
  else
    bw_fail "layer 2: host-01 flagged after 2 SSH attempts (ssh_flagged $hs0 -> $hs1)"
  fi
  if [[ "${mf:-1}" == 0 ]]; then
    bw_pass "layer 2: master (allowlisted) with 20 SSH attempts is never in ssh_flagged"
  else
    bw_fail "layer 2: master is in ssh_flagged (allowlist bypassed)"
  fi
  banner="$(_fe_ssh black-rocky-02 'timeout 5 bash -c "exec 3<>/dev/tcp/172.28.0.16/22; head -c 4 <&3"' 2>/dev/null)"
  if [[ "$banner" == SSH- ]]; then
    bw_pass "layer 2: flagged rocky still completes an SSH handshake (nothing dropped in observe)"
  else
    bw_fail "layer 2: flagged rocky got no SSH banner ('${banner:-none}'): something is dropping"
  fi
  local cf=0 cs
  for cs in ssh_flagged scan_flagged rate_flagged; do
    [[ "$(_fg_flagged "$cs" 172.28.0.1)" == 0 ]] || cf=1
  done
  if [[ "$cf" == 0 ]]; then
    bw_pass "layer 2: controller path 172.28.0.1 (allowlisted) is never in ssh_flagged/scan_flagged/rate_flagged"
  else
    bw_fail "layer 2: controller source 172.28.0.1 is flagged (add it to fang_allowlist)"
  fi
  a1="$(_fe_wait sentinel 100210 black-sentinel-03 172.28.0.15 "$lstart")"
  a2="$(_fe_wait sentinel 100211 black-sentinel-03 172.28.0.15 "$lstart")"
  a3="$(_fe_wait sentinel 100212 black-sentinel-03 172.28.0.15 "$lstart")"
  if [[ "$a1" -gt 0 && "$a2" -gt 0 && "$a3" -gt 0 ]]; then
    bw_pass "layer 2: rules 100210, 100211 and 100212 for srcip 172.28.0.15 (sentinel indexer)"
  else
    bw_fail "layer 2: missing alerts within 150 s (100210: ${a1:-0}, 100211: ${a2:-0}, 100212: ${a3:-0})"
  fi

  # 2b. a degraded refresh (download fails, cache used) must become a Wazuh alert.
  local dstart rc
  dstart="$(_fe_ssh black-sentinel-03 'date -u -d "-3 seconds" +%Y-%m-%dT%H:%M:%SZ' 2>/dev/null)"
  rc="$(_fg_degraded_refresh)"
  if [[ "$rc" != 3 ]]; then
    bw_fail "degraded refresh: expected exit 3 (from cache), got '${rc:-?}'"
  else
    local n=0 i
    for ((i = 0; i < 30; i++)); do
      n="$(_fg_rule_count 100209 "$dstart")"
      [[ "${n:-0}" -gt 0 ]] && break
      sleep 5
    done
    if [[ "${n:-0}" -gt 0 ]]; then
      bw_pass "degraded refresh: exit 3 from cache -> rule 100209 (sentinel indexer)"
    else
      bw_fail "degraded refresh: no rule 100209 alert within 150 s"
    fi
  fi

  # 3. enforce: rocky dropped in prerouting; master, podman egress and DNS unaffected.
  if ! out="$(_fg_provision enforce)"; then
    bw_fail "provision fang (enforce) failed"
    printf '%s\n' "$out" | tail -15 | sed 's/^/      /'
    _fg_restore
    trap - INT TERM
    return
  fi
  start="$(_fe_ssh black-sentinel-03 'date -u -d "-3 seconds" +%Y-%m-%dT%H:%M:%SZ' 2>/dev/null)"
  sleep 15   # the exporter baselines the new table (kind blocklist_dropped)
  o0="$(_fg_counter blackwall_wall origin_direct 172.28.0.15)"
  h0="$(_fg_counter blackwall_fang fang_hits 172.28.0.15)"
  _fg_poke
  sleep 2
  h1="$(_fg_counter blackwall_fang fang_hits 172.28.0.15)"
  o1="$(_fg_counter blackwall_wall origin_direct 172.28.0.15)"
  if [[ "${h1:-0}" -gt "${h0:-0}" ]]; then
    bw_pass "enforce: fang counter for rocky grows ($h0 -> $h1)"
  else
    bw_fail "enforce: fang counter for rocky did not grow ($h0 -> ${h1:-?})"
  fi
  if [[ -n "$o1" && "$o1" == "$o0" ]]; then
    bw_pass "enforce: rocky is dropped before cf-wall (origin_direct unchanged at $o1)"
  else
    bw_fail "enforce: cf-wall origin_direct changed for rocky ($o0 -> ${o1:-?}): packets get past fang"
  fi
  _fg_poke    # growth after the baseline for the exporter
  alerts="$(_fe_wait sentinel 100208 black-sentinel-03 172.28.0.15 "$start")"
  if [[ "$alerts" -gt 0 ]]; then
    bw_pass "enforce: rule 100208 (blocklist_dropped) for srcip 172.28.0.15 (sentinel indexer)"
  else
    bw_fail "enforce: no rule 100208 alert for 172.28.0.15 within 150 s"
  fi
  # Over-blocking proof: host-01 is neither listed nor allowlisted, so Fang must let it
  # through to cf-wall (which counts it as origin_direct) without counting it in fang_hits.
  local ho0 ho1 hf
  ho0="$(_fg_counter blackwall_wall origin_direct 172.28.0.11)"
  _fg_poke black-host-01
  sleep 2
  ho1="$(_fg_counter blackwall_wall origin_direct 172.28.0.11)"
  hf="$(_fg_counter blackwall_fang fang_hits 172.28.0.11)"
  if [[ -n "$ho1" && "$ho1" -gt "${ho0:-0}" && "${hf:-0}" == 0 ]]; then
    bw_pass "enforce: unlisted host-01 passes fang (origin_direct $ho0 -> $ho1, not in fang_hits)"
  else
    bw_fail "enforce: host-01 over-blocked or miscounted (origin_direct $ho0 -> ${ho1:-?}, fang_hits ${hf:-?})"
  fi
  local code
  code="$(_fe_ssh black-master-00 "curl -s -m 8 -o /dev/null -w '%{http_code}' http://172.28.0.16:443/" 2>/dev/null)"
  if [[ "$code" == 200 ]]; then
    bw_pass "enforce: master (allowlisted) still gets 200 on 443"
  else
    bw_fail "enforce: master got '${code:-no answer}' on 443"
  fi
  if _fe_ssh black-sentinel-03 'podman exec web wget -q --spider -T 8 http://example.com' >/dev/null 2>&1; then
    bw_pass "enforce: podman egress works"
  else
    bw_fail "enforce: podman egress (wget from the web container) failed"
  fi
  if _fe_ssh black-sentinel-03 'podman exec web getent hosts example.com' >/dev/null 2>&1; then
    bw_pass "enforce: container DNS works"
  else
    bw_fail "enforce: container DNS failed"
  fi

  # 4. a junk list must abort the refresh and leave the live table and file as they were.
  local fp0 fp1 rc
  fp0="$(_fg_fingerprint)"
  rc="$(_fe_ssh black-sentinel-03 'set -e; d=$(mktemp -d)
      printf "garbage\nnot an ip\n" > "$d/junk.netset"
      sed "s#^SOURCES=.*#SOURCES=\"file://$d/junk.netset\"#" /etc/blackwall/fang.conf > "$d/fang.conf"
      set +e
      BLACKWALL_FANG_CONF="$d/fang.conf" /usr/local/sbin/blackwall-fang-refresh >/dev/null 2>&1
      echo $?; rm -rf "$d"' 2>/dev/null | tail -1)"
  fp1="$(_fg_fingerprint)"
  if [[ "$rc" == 1 && "$fp0" == "$fp1" ]]; then
    bw_pass "junk list: refresh aborted (exit 1), live table and persisted file unchanged"
  else
    bw_fail "junk list: exit '${rc:-?}', table/file unchanged: $([[ "$fp0" == "$fp1" ]] && echo yes || echo NO)"
  fi

  # 5. back to observe.
  _fg_restore
  trap - INT TERM
  if _fe_ssh black-sentinel-03 'grep -q "^MODE=observe" /etc/blackwall/fang.conf && ! nft list table inet blackwall_fang | grep -q " drop"' >/dev/null 2>&1; then
    bw_pass "fang is in observe mode again (no drop rule)"
  else
    bw_fail "fang is not back in observe mode"
  fi
}

# --- vm: auditd role on a real RHEL kernel (blackwall-eye/docs/backlog.md) ---

_vm_prov()      { bw_vm_ansible blackwall-eye ansible/playbooks/monitored-host.yml --tags auditd "$@"; }
_vm_verify()    { bw_vm_ansible blackwall-eye ansible/playbooks/verify-auditd.yml "$@"; }
_vm_apply()     { _vm_prov "$@" >/dev/null 2>&1; }
_vm_started()   { limactl shell "$BW_VM" systemctl show auditd -p ExecMainStartTimestampMonotonic --value 2>/dev/null; }
_vm_immutable() { limactl shell "$BW_VM" sudo auditctl -s 2>/dev/null | grep -q '^enabled 2'; }
_vm_reboot()    { limactl stop "$BW_VM" >/dev/null 2>&1 && limactl start --tty=false "$BW_VM" >/dev/null 2>&1; }
# _vm_rules <json list items> — extra vars for auditd_extra_rules
_vm_rules()     { printf '{"auditd_extra_rules": [%s]}' "$1"; }

# Back to role defaults with a mutable kernel. Immutable rules can only be
# dropped by writing the default rules and rebooting.
_vm_restore() {
  _vm_apply
  if _vm_immutable; then _vm_reboot; fi
}

check_vm() {
  bw_info "vm (auditd on a real RHEL kernel: $BW_VM)"
  if ! command -v limactl >/dev/null 2>&1; then
    bw_skip "limactl not installed (brew install lima)"; return
  fi
  if [[ "$(bw_vm_status)" != Running ]]; then
    bw_skip "$BW_VM is not running (run: bw-lab vm up)"; return
  fi
  bw_require_ansible

  local hosts='"-w /etc/hosts -p wa -k bw_vm_hosts"'
  local hostname='"-w /etc/hostname -p wa -k bw_vm_hostname"'
  local bad='"-w /etc/hosts -p zz -k bw_vm_bad"'
  local before after out

  # Role defaults, mutable kernel: a run stopped half way may have left -e 2.
  _vm_restore

  # 1. Defaults: package, config, rules on disk and in the kernel, service up.
  bw_run "1. defaults: auditd active, blackwall rules loaded in the kernel" _vm_verify

  # 2. A rule change is a reload (augenrules --load), not a restart.
  before="$(_vm_started)"
  bw_run "2. changed rule: play passes, the new rule is loaded" \
    _vm_step "$(_vm_rules "$hosts")" -- -e expect_key=bw_vm_hosts
  after="$(_vm_started)"
  if [[ -n "$before" && "$before" == "$after" ]]; then
    bw_pass "2. rule change reloaded rules without restarting auditd"
  else
    bw_fail "2. rule change restarted auditd (start time $before -> $after)"
  fi

  # 3. A config change restarts auditd (service auditd restart on RHEL).
  before="$after"
  bw_run "3. changed log_format: play passes, RAW in auditd.conf, rule still loaded" \
    _vm_step "$(_vm_rules "$hosts")" -e auditd_log_format=RAW \
      -- -e expect_log_format=RAW -e expect_key=bw_vm_hosts
  after="$(_vm_started)"
  if [[ -n "$after" && "$before" != "$after" ]]; then
    bw_pass "3. log_format change restarted auditd"
  else
    bw_fail "3. log_format change did not restart auditd (start time $before -> $after)"
  fi

  # 5 (before 4: on an immutable kernel nothing is loaded, so nothing can fail).
  # A broken rule must fail the play: there is no /.dockerenv to ignore it.
  if _vm_apply -e "$(_vm_rules "$bad")"; then
    bw_fail "5. broken rule (-p zz) did not fail the play"
  else
    bw_pass "5. broken rule (-p zz) fails the play"
  fi
  bw_run "5. valid rules load again after the broken one" \
    _vm_step "$(_vm_rules "$hosts")" -- -e expect_key=bw_vm_hosts -e expect_no_key=bw_vm_bad

  # 4. Immutable rules (-e 2, as CIS/STIG profiles do).
  bw_run "4. auditd_immutable: kernel reports enabled 2" \
    _vm_step "$(_vm_rules "$hosts")" -e auditd_immutable=true \
      -- -e expect_immutable=true -e expect_key=bw_vm_hosts
  _vm_reboot
  bw_run "4. still immutable after reboot (rules from disk at boot)" \
    _vm_verify -e expect_immutable=true -e expect_key=bw_vm_hosts
  if out="$(_vm_prov -e "$(_vm_rules "$hosts,$hostname")" -e auditd_immutable=true 2>&1)"; then
    if grep -q 'REBOOT REQUIRED' <<<"$out"; then
      bw_pass "4. rule change on an immutable kernel: play passes, reports REBOOT REQUIRED"
    else
      bw_fail "4. rule change on an immutable kernel: no REBOOT REQUIRED in the output"
    fi
  else
    bw_fail "4. rule change on an immutable kernel failed the play"
    printf '%s\n' "$out" | tail -25 | sed 's/^/      /'
  fi
  bw_run "4. the new rule waits for the reboot (not loaded yet)" \
    _vm_verify -e expect_immutable=true -e expect_key=bw_vm_hosts -e expect_no_key=bw_vm_hostname
  _vm_reboot
  bw_run "4. after reboot the new rule is loaded" \
    _vm_verify -e expect_immutable=true -e expect_key=bw_vm_hostname

  # Back to defaults (one more reboot to drop -e 2).
  _vm_restore
  bw_run "cleanup: role defaults, kernel mutable, test rules gone" \
    _vm_verify -e expect_no_key=bw_vm_hosts
}

# _vm_step <auditd_extra_rules json> [provision args...] -- [verify args...]
_vm_step() {
  local rules="$1"; shift
  local prov=() ver=()
  while [[ $# -gt 0 && "$1" != -- ]]; do prov+=("$1"); shift; done
  [[ "${1:-}" == -- ]] && shift
  ver=("$@")
  # ${a[@]+"${a[@]}"}: an empty array under set -u on bash 3.2 (macOS /bin/bash)
  _vm_prov -e "$rules" ${prov[@]+"${prov[@]}"} && _vm_verify ${ver[@]+"${ver[@]}"}
}

main() {
  case "${1:-all}" in
    all)
      check_hosts; check_versions; check_nft; check_cf_wall; check_ports
      check_wazuh; check_metrics; check_voice; check_brain
      check_sentinel
      ;;
    hosts)    check_hosts ;;
    versions) check_versions ;;
    nft)      check_nft ;;
    cf-wall)  check_cf_wall ;;
    ports)    check_ports ;;
    wazuh)    check_wazuh ;;
    metrics)  check_metrics ;;
    voice)    check_voice ;;
    brain)    check_brain ;;
    sentinel) check_sentinel ;;
    sentinel-agents) check_sentinel_agents ;;
    fw-events) check_fw_events ;;
    fang) check_fang ;;
    vm) check_vm ;;
    -h|--help|help) usage; exit 0 ;;
    *) printf 'unknown check: %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  bw_summary
}

main "$@"
